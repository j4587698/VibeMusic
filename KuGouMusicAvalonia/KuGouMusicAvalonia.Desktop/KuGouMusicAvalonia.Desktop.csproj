<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>VibeMusic</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\KuGouMusicAvalonia\Assets\vibe-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="LuminaUI.Diagnostics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KuGouMusicAvalonia\KuGouMusicAvalonia.csproj" />
    <!-- updater 是独立可执行文件，不作为程序集引用，只保证它先于本项目构建。 -->
    <ProjectReference Include="..\KuGouMusicAvalonia.Updater\KuGouMusicAvalonia.Updater.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- 把 updater 的产物复制到输出目录，使其与主程序同处安装目录。 -->
  <Target Name="CopyUpdaterOutput" AfterTargets="Build">
    <MSBuild Projects="..\KuGouMusicAvalonia.Updater\KuGouMusicAvalonia.Updater.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="UpdaterBuildOutput" />
    </MSBuild>
    <ItemGroup>
      <UpdaterFiles Include="%(UpdaterBuildOutput.RootDir)%(UpdaterBuildOutput.Directory)VibeMusic.Updater.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- 本地调试：SimpleAudioPlayer 走项目引用，但 native 仍由 NuGet 包提供。
       这里用本地新编译的 native 覆盖输出，确保运行的是最新 native。 -->
  <PropertyGroup>
    <LocalNativeAudioPlayerDll>E:\SimpleAudioPlayer\build\native-win64\bin\libaudio_player.dll</LocalNativeAudioPlayerDll>
  </PropertyGroup>
  <Target Name="OverrideLocalNativeAudioPlayer" AfterTargets="Build" Condition="Exists('$(LocalNativeAudioPlayerDll)')">
    <Copy SourceFiles="$(LocalNativeAudioPlayerDll)" DestinationFolder="$(OutDir)runtimes\win-x64\native" />
    <Copy SourceFiles="$(LocalNativeAudioPlayerDll)" DestinationFolder="$(OutDir)" />
    <Message Importance="high" Text="[native] 已用本地编译的 libaudio_player.dll 覆盖输出" />
  </Target>
</Project>
