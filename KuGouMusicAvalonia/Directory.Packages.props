    <PackageVersion Include="LuminaUI" Version="0.7.0" />
    <PackageVersion Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageVersion Include="TinyDb" Version="0.6.5" />
  </ItemGroup>
</Project>
