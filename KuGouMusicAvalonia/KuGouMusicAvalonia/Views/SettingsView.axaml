<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
             xmlns:services="using:KuGouMusicAvalonia.Services"
             xmlns:converters="using:KuGouMusicAvalonia.Converters"
             xmlns:kugou="clr-namespace:KuGou.Lite;assembly=KuGouLiteSdk"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="760"
             x:Class="KuGouMusicAvalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <Style Selector="Border.UserLibraryMetric">
      <Setter Property="Background" Value="{DynamicResource MusicGlassLightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MusicOutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.UserLibraryMetric:pointerover">
      <Setter Property="Background" Value="{DynamicResource MusicSurfaceHighBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,0,12,30" Spacing="18">
      <Border IsVisible="{Binding IsLoginPromptVisible}" CornerRadius="20" MinHeight="156" Background="{DynamicResource MusicHeroGradient}" ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="18">
          <lumina:LuminaAvatar Content="K" Size="80" Background="{DynamicResource MusicPrimaryGradient}" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" FontSize="28" FontWeight="Black" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" MinWidth="0">
            <TextBlock Text="酷狗账号" FontSize="26" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" TextWrapping="Wrap" MaxLines="2" />
            <TextBlock Text="登录后同步头像、歌单、云盘和最近播放" FontSize="14" Foreground="{DynamicResource MusicTextSoftBrush}" TextWrapping="Wrap" />
            <Button Classes="Primary Icon" Command="{Binding StartLoginCommand}" Width="40" Height="40" CornerRadius="20" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" Padding="0" HorizontalAlignment="Left" Background="{DynamicResource MusicPrimaryGradient}" ToolTip.Tip="登录" lumina:LuminaButton.IconSize="22">
              <icons:MaterialIcon Kind="Login" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid IsVisible="{Binding IsLoggedInPanelVisible}">
        <Border IsVisible="{Binding IsWideLayout}" CornerRadius="22" MinHeight="190" Background="{DynamicResource MusicHeroGradient}" ClipToBounds="True">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22" Margin="24">
            <Border Width="104" Height="104" CornerRadius="52" Background="{DynamicResource MusicPrimaryGradient}" ClipToBounds="True">
              <Grid>
                <TextBlock Text="K" FontSize="38" FontWeight="Black" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <lumina:LuminaImage Source="{Binding UserAvatarUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
              <lumina:LuminaAutoScrollText Text="{Binding UserDisplayName}" FontSize="30" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding UserIdText}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" />
              <TextBlock IsVisible="{Binding HasUserExpireText}" Text="{Binding UserExpireText}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" TextWrapping="Wrap" />
              <TextBlock IsVisible="{Binding HasUserProfileStatus}" Text="{Binding UserProfileStatus}" FontSize="13" Foreground="{DynamicResource MusicTextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10">
              <Button Classes="Ghost Icon" Command="{Binding RefreshUserDataCommand}" Width="44" Height="44" ToolTip.Tip="同步资料" lumina:LuminaButton.IconSize="25">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Sync" Width="25" Height="25" Foreground="{DynamicResource MusicPrimaryBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
              <Button Classes="Outline" Command="{Binding ClearLoginCommand}" Height="38" CornerRadius="19" BorderBrush="#44FFFFFF" Background="#22000000" Padding="14,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <icons:MaterialIcon Kind="Logout" Width="24" Height="24" Foreground="{DynamicResource MusicTextBrush}" />
                  <TextBlock Text="登出" Foreground="{DynamicResource MusicTextBrush}" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Border IsVisible="{Binding IsCompactLayout}" CornerRadius="22" Background="{DynamicResource MusicHeroGradient}" ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="16" Margin="18">
            <Grid ColumnDefinitions="82,*" ColumnSpacing="14">
              <Border Width="78" Height="78" CornerRadius="39" Background="{DynamicResource MusicPrimaryGradient}" ClipToBounds="True" VerticalAlignment="Top">
                <Grid>
                  <TextBlock Text="K" FontSize="28" FontWeight="Black" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <lumina:LuminaImage Source="{Binding UserAvatarUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                </Grid>
              </Border>

              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MinWidth="0">
                <lumina:LuminaAutoScrollText Text="{Binding UserDisplayName}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding UserIdText}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock IsVisible="{Binding HasUserExpireText}" Text="{Binding UserExpireText}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" TextWrapping="Wrap" MaxLines="2" />
                <TextBlock IsVisible="{Binding HasUserProfileStatus}" Text="{Binding UserProfileStatus}" FontSize="12" Foreground="{DynamicResource MusicTextMutedBrush}" TextWrapping="Wrap" MaxLines="2" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Classes="Ghost Icon" Command="{Binding RefreshUserDataCommand}" Width="42" Height="42" ToolTip.Tip="同步资料" lumina:LuminaButton.IconSize="24">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Sync" Width="24" Height="24" Foreground="{DynamicResource MusicPrimaryBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
              <Button Classes="Outline" Command="{Binding ClearLoginCommand}" Height="38" CornerRadius="19" BorderBrush="#44FFFFFF" Background="#22000000" Padding="14,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <icons:MaterialIcon Kind="Logout" Width="23" Height="23" Foreground="{DynamicResource MusicTextBrush}" />
                  <TextBlock Text="登出" Foreground="{DynamicResource MusicTextBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border IsVisible="{Binding IsLoggedInPanelVisible}" CornerRadius="18" Background="{DynamicResource MusicGlassBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" Padding="18">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="我的资料" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
              <TextBlock Text="歌单、云盘/收藏读取本地缓存，点击同步刷新服务端资料" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsProfileBusy}" Width="120" Height="4" VerticalAlignment="Center" />
          </Grid>

          <UniformGrid Columns="3">
            <Border Classes="UserLibraryMetric"
                    Margin="0,0,10,0"
                    Padding="12,10"
                    CornerRadius="12"
                    Cursor="Hand"
                    lumina:LuminaCommand.TappedCommand="{Binding OpenUserPlaylistsCommand}">
              <StackPanel Spacing="3" MinWidth="0">
                <TextBlock Text="{Binding UserPlaylistCountText}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <TextBlock Text="歌单" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" />
              </StackPanel>
            </Border>
            <Border Classes="UserLibraryMetric"
                    Margin="0,0,10,0"
                    Padding="12,10"
                    CornerRadius="12"
                    Cursor="Hand"
                    lumina:LuminaCommand.TappedCommand="{Binding OpenUserCloudCommand}">
              <StackPanel Spacing="3" MinWidth="0">
                <TextBlock Text="{Binding UserCollectionCountText}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <TextBlock Text="云盘/收藏" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" />
              </StackPanel>
            </Border>
            <Border Classes="UserLibraryMetric"
                    Padding="12,10"
                    CornerRadius="12"
                    Cursor="Hand"
                    lumina:LuminaCommand.TappedCommand="{Binding OpenUserHistoryCommand}">
              <StackPanel Spacing="3" MinWidth="0">
                <TextBlock Text="{Binding UserHistoryCountText}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <TextBlock Text="最近播放" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <StackPanel IsVisible="{Binding IsCompactLayout}" Spacing="10">
            <TextBlock Text="最近同步内容" FontSize="16" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
            <ItemsControl ItemsSource="{Binding UserLibraryPreview}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UserLibraryItem">
                  <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10" Margin="0,0,0,8">
                    <Border Width="42" Height="42" CornerRadius="8" Background="#24FFFFFF" ClipToBounds="True">
                      <lumina:LuminaImage Source="{Binding CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                      <lumina:LuminaAutoScrollText Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                      <lumina:LuminaAutoScrollText Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MusicTextMutedBrush}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="8,3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MusicTextSoftBrush}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Grid IsVisible="{Binding IsWideLayout}" ColumnDefinitions="*,*,*" ColumnSpacing="14">
            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding UserPlaylists}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:UserLibraryItem">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="10" Margin="0,0,0,8">
                      <Border Width="42" Height="42" CornerRadius="8" Background="#24FFFFFF" ClipToBounds="True">
                        <lumina:LuminaImage Source="{Binding CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                        <lumina:LuminaAutoScrollText Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                        <lumina:LuminaAutoScrollText Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MusicTextMutedBrush}" HorizontalAlignment="Stretch" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding UserCollections}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:UserLibraryItem">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="10" Margin="0,0,0,8">
                      <Border Width="42" Height="42" CornerRadius="8" Background="#24FFFFFF" ClipToBounds="True">
                        <lumina:LuminaImage Source="{Binding CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                        <lumina:LuminaAutoScrollText Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                        <lumina:LuminaAutoScrollText Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MusicTextMutedBrush}" HorizontalAlignment="Stretch" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding UserHistory}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="kugou:KugouSong">
                    <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10" Margin="0,0,0,8">
                      <Border Width="42" Height="42" CornerRadius="8" Background="#24FFFFFF" ClipToBounds="True">
                        <lumina:LuminaImage Source="{Binding CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                        <lumina:LuminaAutoScrollText Text="{Binding Title}" FontWeight="Bold" HorizontalAlignment="Stretch">
                          <lumina:LuminaAutoScrollText.Foreground>
                            <MultiBinding Converter="{x:Static converters:SongPlayingBrushConverter.Instance}">
                              <Binding />
                              <Binding Path="CurrentSong" Source="{x:Static services:PlayerService.Instance}" />
                            </MultiBinding>
                          </lumina:LuminaAutoScrollText.Foreground>
                        </lumina:LuminaAutoScrollText>
                        <lumina:LuminaAutoScrollText Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource MusicTextMutedBrush}" HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="Primary Icon" Width="32" Height="32" CornerRadius="16" ToolTip.Tip="播放/暂停" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).PlayHistorySongCommand}" CommandParameter="{Binding}" Background="{DynamicResource MusicPrimaryGradient}">
                        <icons:MaterialIcon Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" Width="20" Height="20">
                          <icons:MaterialIcon.Kind>
                            <MultiBinding Converter="{x:Static converters:SongPlayIconConverter.Instance}">
                              <Binding />
                              <Binding Path="CurrentSong" Source="{x:Static services:PlayerService.Instance}" />
                              <Binding Path="IsPlaying" Source="{x:Static services:PlayerService.Instance}" />
                            </MultiBinding>
                          </icons:MaterialIcon.Kind>
                        </icons:MaterialIcon>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </StackPanel>
      </Border>

      <Border CornerRadius="18" Background="{DynamicResource MusicGlassBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" Padding="18">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="畅听与 VIP 权益" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
              <TextBlock Text="{Binding VipStatus}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsVipBusy}" Width="120" Height="4" VerticalAlignment="Center" />
          </Grid>

          <lumina:LuminaSettingsOption Grid.Row="1" Kind="Custom" Header="自动领取权益" Description="播放前检查并领取今日畅听/VIP，失败时继续播放" ShowChevron="False">
            <lumina:LuminaSettingsOption.TrailingContent>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="SettingsSwitchText" Text="{Binding AutoReceiveVipBeforePlayback, Converter={StaticResource BooleanToSwitchTextConverter}}" />
                <ToggleSwitch Classes="SettingsSwitch" IsChecked="{Binding AutoReceiveVipBeforePlayback, Mode=TwoWay}" />
              </StackPanel>
            </lumina:LuminaSettingsOption.TrailingContent>
          </lumina:LuminaSettingsOption>

          <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button Classes="Outline Icon" Command="{Binding RefreshVipStateCommand}" Width="40" Height="40" CornerRadius="20" Padding="0" Margin="0,0,10,10" ToolTip.Tip="刷新" lumina:LuminaButton.IconSize="22">
              <icons:MaterialIcon Kind="Refresh" Width="22" Height="22" Foreground="{DynamicResource MusicTextBrush}" />
            </Button>
            <Button Classes="Primary Icon" Command="{Binding ClaimVipCommand}" Width="40" Height="40" CornerRadius="20" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" Padding="0" Margin="0,0,10,10" Background="{DynamicResource MusicPrimaryGradient}" ToolTip.Tip="获取" lumina:LuminaButton.IconSize="22">
              <icons:MaterialIcon Kind="Crown" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
            </Button>
          </WrapPanel>
        </Grid>
      </Border>

      <Border IsVisible="{Binding IsFloatingLyricsSupported}" CornerRadius="18" Background="{DynamicResource MusicGlassBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" Padding="18">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="悬浮歌词" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
              <TextBlock Text="{Binding FloatingLyricsStatusText}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <icons:MaterialIcon Grid.Column="1" Kind="Subtitles" Width="28" Height="28" Foreground="{DynamicResource MusicPrimaryBrush}" VerticalAlignment="Center" />
          </Grid>

          <lumina:LuminaSettingsOption Kind="Custom" Header="显示悬浮歌词" Description="在桌面端打开独立置顶歌词窗；Android 端会请求系统悬浮窗权限" ShowChevron="False">
            <lumina:LuminaSettingsOption.TrailingContent>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="SettingsSwitchText" Text="{Binding IsFloatingLyricsOpen, Converter={StaticResource BooleanToSwitchTextConverter}}" />
                <ToggleSwitch Classes="SettingsSwitch" IsChecked="{Binding IsFloatingLyricsOpen, Mode=TwoWay}" />
              </StackPanel>
            </lumina:LuminaSettingsOption.TrailingContent>
          </lumina:LuminaSettingsOption>

          <lumina:LuminaSettingsOption Kind="Custom" Header="锁定浮窗" Description="锁定后鼠标/触摸穿透浮窗；需要解锁时回到这里关闭" ShowChevron="False">
            <lumina:LuminaSettingsOption.TrailingContent>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="SettingsSwitchText" Text="{Binding IsFloatingLyricsLocked, Converter={StaticResource BooleanToSwitchTextConverter}}" />
                <ToggleSwitch Classes="SettingsSwitch" IsChecked="{Binding IsFloatingLyricsLocked, Mode=TwoWay}" />
              </StackPanel>
            </lumina:LuminaSettingsOption.TrailingContent>
          </lumina:LuminaSettingsOption>

          <lumina:LuminaSettingsOption IsVisible="{Binding IsFloatingLyricsCompactModeSupported}" Kind="Custom" Header="紧凑模式" Description="只显示当前歌词，减少浮窗占用空间" ShowChevron="False">
            <lumina:LuminaSettingsOption.TrailingContent>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="SettingsSwitchText" Text="{Binding IsFloatingLyricsCompactMode, Converter={StaticResource BooleanToSwitchTextConverter}}" />
                <ToggleSwitch Classes="SettingsSwitch" IsChecked="{Binding IsFloatingLyricsCompactMode, Mode=TwoWay}" />
              </StackPanel>
            </lumina:LuminaSettingsOption.TrailingContent>
          </lumina:LuminaSettingsOption>

          <lumina:LuminaSettingsOption Kind="Custom" Header="主歌词字号" Description="{Binding FloatingLyricsFontSizeText, StringFormat='当前字号 {0}'}" ShowChevron="False">
            <lumina:LuminaSettingsOption.TrailingContent>
              <lumina:LuminaInputGroup Width="126" FillIndex="0">
                <NumericUpDown Height="38"
                               Minimum="{Binding FloatingLyricsMinFontSize}"
                               Maximum="{Binding FloatingLyricsMaxFontSize}"
                               Increment="1"
                               FormatString="0"
                               Value="{Binding FloatingLyricsFontSize, Mode=TwoWay}"
                               FontSize="16"
                               ShowButtonSpinner="False"
                               TextAlignment="Center"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center" />
                <Button Classes="Outline Icon" Width="38" Height="38" Command="{Binding ResetFloatingLyricsFontSizeCommand}" ToolTip.Tip="重置字号" lumina:LuminaButton.IconSize="20">
                  <lumina:LuminaButton.Icon>
                    <icons:MaterialIcon Kind="Refresh" Width="20" Height="20" Foreground="{DynamicResource MusicTextSoftBrush}" />
                  </lumina:LuminaButton.Icon>
                </Button>
              </lumina:LuminaInputGroup>
            </lumina:LuminaSettingsOption.TrailingContent>
          </lumina:LuminaSettingsOption>
        </StackPanel>
      </Border>

      <Border CornerRadius="18" Background="{DynamicResource MusicGlassBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" Padding="18">
        <StackPanel Spacing="16">
          <TextBlock Text="设置" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />

          <Grid ColumnDefinitions="180,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
            <lumina:LuminaSettingsSelectOption Grid.ColumnSpan="2" Kind="Select" Header="主题" SelectItemsSource="{Binding ThemeModeOptions}" SelectedItem="{Binding ThemeMode, Mode=TwoWay}" />

            <lumina:LuminaSettingsOption Grid.Row="1" Grid.ColumnSpan="2" Kind="Custom" Header="边播边存" Description="已下载歌曲优先本地播放；未下载时边播边保存" ShowChevron="False">
              <lumina:LuminaSettingsOption.TrailingContent>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="SettingsSwitchText" Text="{Binding StreamWhileDownloading, Converter={StaticResource BooleanToSwitchTextConverter}}" />
                  <ToggleSwitch Classes="SettingsSwitch" IsChecked="{Binding StreamWhileDownloading, Mode=TwoWay}" />
                </StackPanel>
              </lumina:LuminaSettingsOption.TrailingContent>
            </lumina:LuminaSettingsOption>

            <lumina:LuminaSettingsOption Grid.Row="2" Grid.ColumnSpan="2" Kind="Custom" Header="逐字歌词" Description="优先获取并显示 KRC 逐字歌词 (卡拉OK效果)，否则使用标准 LRC 行歌词" ShowChevron="False">
              <lumina:LuminaSettingsOption.TrailingContent>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="SettingsSwitchText" Text="{Binding PreferKrc, Converter={StaticResource BooleanToSwitchTextConverter}}" />
                  <ToggleSwitch Classes="SettingsSwitch" IsChecked="{Binding PreferKrc, Mode=TwoWay}" />
                </StackPanel>
              </lumina:LuminaSettingsOption.TrailingContent>
            </lumina:LuminaSettingsOption>

            <lumina:LuminaSettingsOption Grid.Row="3" Grid.ColumnSpan="2" Kind="Custom" Header="关闭主界面" Description="关闭窗口时最小化到系统托盘（仅电脑端）" ShowChevron="False" IsVisible="{Binding IsDesktopSettingVisible}">
              <lumina:LuminaSettingsOption.TrailingContent>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="SettingsSwitchText" Text="{Binding MinimizeToTrayOnClose, Converter={StaticResource BooleanToSwitchTextConverter}}" />
                  <ToggleSwitch Classes="SettingsSwitch" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                </StackPanel>
              </lumina:LuminaSettingsOption.TrailingContent>
            </lumina:LuminaSettingsOption>

            <lumina:LuminaSettingsOption Grid.Row="4" Grid.ColumnSpan="2" Kind="Custom" Header="存储位置" Description="{Binding DownloadDirectory}" ShowChevron="True" Command="{Binding PickDownloadDirectoryCommand}" IsVisible="{Binding IsDesktopSettingVisible}" />

            <lumina:LuminaSettingsSelectOption Grid.Row="5" Grid.ColumnSpan="2" Kind="Select" Header="默认播放比特率" SelectItemsSource="{Binding PlaybackQualityOptions}" SelectedItem="{Binding DefaultPlaybackQuality, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>

  <Grid IsVisible="{Binding IsLoginDialogOpen}" ZIndex="40">
    <Border Background="#A6000000" lumina:LuminaCommand.TappedCommand="{Binding CloseLoginDialogCommand}" />
    <Border Width="{Binding LoginDialogWidth}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="22"
            Background="{DynamicResource MusicSurfaceBrush}"
            BorderBrush="{DynamicResource MusicOutlineBrush}"
            BorderThickness="1"
            BoxShadow="{DynamicResource MusicFloatingShadow}"
            ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Grid Margin="18,16,12,10" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="登录酷狗账号" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
            <TextBlock Text="{Binding LoginStatus}" FontSize="12" Foreground="{DynamicResource MusicTextMutedBrush}" TextWrapping="Wrap" MaxLines="2" />
          </StackPanel>
          <Button Grid.Column="1" Classes="Ghost Icon" Command="{Binding CloseLoginDialogCommand}" Width="38" Height="38" ToolTip.Tip="关闭登录" lumina:LuminaButton.IconSize="22">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Close" Width="22" Height="22" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
        </Grid>

        <TabControl Grid.Row="1" SelectedIndex="{Binding LoginTabIndex, Mode=TwoWay}" Margin="0,0,0,12">
          <TabItem Header="二维码">
            <StackPanel Margin="18,14,18,6" Spacing="14">
              <Border Width="220" Height="220" CornerRadius="18" Background="White" HorizontalAlignment="Center" Padding="10" ClipToBounds="True">
                <Grid>
                  <TextBlock Text="QR" FontSize="42" FontWeight="Black" Foreground="#3368000A" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasQrCode}" />
                  <Image Source="{Binding QrCodeImage}" Stretch="Uniform" IsVisible="{Binding HasQrCode}" />
                </Grid>
              </Border>

              <StackPanel Spacing="8">
                <TextBlock Text="{Binding QrStatus}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsQrPolling}" Width="160" Height="4" HorizontalAlignment="Center" />
              </StackPanel>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Classes="Primary" Command="{Binding StartQrLoginCommand}" Height="40" CornerRadius="20" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" Padding="14,0" Background="{DynamicResource MusicPrimaryGradient}">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Qrcode" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                    <TextBlock Text="生成二维码" FontWeight="Black" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="Ghost" Command="{Binding CancelQrLoginCommand}" Height="40" CornerRadius="20" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="14,0">
                  <TextBlock Text="取消扫码" FontWeight="Bold" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </Grid>
            </StackPanel>
          </TabItem>

          <TabItem Header="手机号">
            <StackPanel Margin="18,16,18,8" Spacing="14">
              <TextBox Classes="Pill MusicPillInput" Text="{Binding PhoneNumber, Mode=TwoWay}" PlaceholderText="手机号" Height="42" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Classes="Pill MusicPillInput" Text="{Binding VerifyCode, Mode=TwoWay}" PlaceholderText="验证码" Height="42" />
                <Button Grid.Column="1" Classes="Outline" Command="{Binding SendCodeCommand}" Height="42" CornerRadius="21" Padding="14,0">
                  <TextBlock Text="发送验证码" Foreground="{DynamicResource MusicTextBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                </Button>
              </Grid>

              <Button Classes="Primary" Command="{Binding LoginByPhoneCommand}" Height="42" CornerRadius="21" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" Background="{DynamicResource MusicPrimaryGradient}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <icons:MaterialIcon Kind="Login" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                  <TextBlock Text="登录" FontWeight="Black" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>
  </Grid>
  </Grid>
</UserControl>

