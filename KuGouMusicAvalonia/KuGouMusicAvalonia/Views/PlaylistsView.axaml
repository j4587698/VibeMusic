<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
             xmlns:controls="using:KuGouMusicAvalonia.Controls"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:kugou="clr-namespace:KuGou.Lite;assembly=KuGouLiteSdk"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="KuGouMusicAvalonia.Views.PlaylistsView"
             x:DataType="vm:PlaylistsViewModel"
             x:CompileBindings="True">
  <controls:PageInsetListBox x:Name="PlaylistsPageList"
                             ItemsSource="{Binding PageItems}"
                             Background="Transparent"
                             BorderThickness="0"
                             BasePadding="0"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>

    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
      </Style>
    </ListBox.Styles>

    <ListBox.DataTemplates>
      <DataTemplate DataType="vm:PlaylistsHeaderSection">
        <StackPanel Margin="12,0,12,8" Spacing="18">
          <Border CornerRadius="22" MinHeight="184" Background="{DynamicResource MusicHeroGradient}" ClipToBounds="True" BoxShadow="{DynamicResource MusicFloatingShadow}">
            <Grid Margin="18" ColumnDefinitions="*,112" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center" Spacing="8" MinWidth="0">
                <TextBlock Text="PLAYLISTS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <TextBlock Text="酷狗歌单" FontSize="28" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" TextWrapping="Wrap" MaxLines="2" />
                <TextBlock Text="推荐歌单、我的歌单和当前队列都放到这里处理。点开歌单后会进入独立详情页。" FontSize="14" Foreground="{DynamicResource MusicTextSoftBrush}" TextWrapping="Wrap" MaxLines="2" />
                <WrapPanel Margin="0,8,0,0">
                  <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="推荐" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicTextSoftBrush}" />
                    <TextBlock Text="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).Playlists.Count}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="我的" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicTextSoftBrush}" />
                    <TextBlock Text="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).UserPlaylists.Count}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
              <Border Grid.Column="1" Width="104" Height="104" CornerRadius="20" Background="{DynamicResource LuminaHoverBackgroundBrush}" ClipToBounds="True" HorizontalAlignment="Right" VerticalAlignment="Center">
                <icons:MaterialIcon Kind="PlaylistMusic" Width="62" Height="62" Foreground="{DynamicResource MusicTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>

          <Border CornerRadius="18" Background="{DynamicResource MusicGlassBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" Padding="14">
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="12">
              <StackPanel>
                <TextBlock Text="我的歌单" FontSize="20" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
                <TextBlock Text="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).UserPlaylistStatusMessage}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="Ghost Icon" Command="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).LoadUserPlaylistsCommand}" Width="32" Height="32" ToolTip.Tip="刷新我的歌单" lumina:LuminaButton.IconSize="18">
                <lumina:LuminaButton.Icon>
                  <icons:MaterialIcon Kind="Refresh" Width="18" Height="18" Foreground="{DynamicResource MusicTextSoftBrush}" />
                </lumina:LuminaButton.Icon>
              </Button>
              <ProgressBar Grid.Column="2" IsIndeterminate="True" IsVisible="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).IsUserPlaylistsLoading}" Width="100" Height="4" VerticalAlignment="Center" />

              <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="10">
                <TextBox Classes="Pill MusicPillInput" Text="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).NewPlaylistName}" PlaceholderText="新歌单名称" Height="40" />
                <WrapPanel>
                <CheckBox IsChecked="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).CreatePlaylistFromQueue}" Content="保存当前队列" VerticalAlignment="Center" Foreground="{DynamicResource MusicTextSoftBrush}" Margin="0,0,10,10" />
                <Button Classes="Primary Icon" Command="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).CreatePlaylistCommand}" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource MusicPrimaryGradient}" Padding="0" Margin="0,0,10,10" ToolTip.Tip="创建" lumina:LuminaButton.IconSize="22">
                  <icons:MaterialIcon Kind="PlaylistMusic" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                </Button>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).UserPlaylists}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="kugou:KugouPlaylist">
                  <lumina:LuminaCard Width="188" Height="88" Margin="0,0,12,16" Padding="10" Classes="Interactive" CornerRadius="14" Cursor="Hand"
                                     lumina:LuminaCommand.TappedCommand="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).OpenPlaylistCommand}"
                                     lumina:LuminaCommand.TappedCommandParameter="{Binding}">
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                      <Border Width="62" Height="62" CornerRadius="12" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True">
                        <lumina:LuminaImage Source="{Binding Pic, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <lumina:LuminaAutoScrollText Text="{Binding Name}" IsRunning="{Binding $parent[lumina:LuminaCard].IsPointerOver}" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding Count, StringFormat='{}{0} 首'}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" />
                        <TextBlock Text="我的歌单" FontSize="11" Foreground="{DynamicResource MusicTextMutedBrush}" />
                      </StackPanel>
                    </Grid>
                  </lumina:LuminaCard>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border CornerRadius="18" Background="{DynamicResource MusicGlassBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" Padding="14">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="我的频道" FontSize="20" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
                  <TextBlock Text="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).ChannelsStatus}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="Primary Icon" Command="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).LoadChannelsCommand}"
                        Width="38" Height="38" CornerRadius="19" Background="{DynamicResource MusicPrimaryGradient}" Padding="0"
                        ToolTip.Tip="刷新" lumina:LuminaButton.IconSize="22" lumina:LuminaButton.IsLoading="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).IsChannelsLoading}">
                  <icons:MaterialIcon Kind="Refresh" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                </Button>
              </Grid>
              <ListBox Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       Background="Transparent" BorderThickness="0" Padding="0"
                       ItemsSource="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).YouthChannels}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                      <ControlTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                      </ControlTemplate>
                    </Setter>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:KugouYouthChannel">
                    <lumina:LuminaCard Margin="0,0,12,16" Width="188" Height="88" Padding="10" Classes="Interactive" CornerRadius="14" Cursor="Hand">
                      <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="10">
                        <Border Width="62" Height="62" CornerRadius="12" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True">
                          <lumina:LuminaImage Source="{Binding CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="Black" FontSize="13" Foreground="{DynamicResource MusicTextBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                          <TextBlock Text="{Binding SongCount, StringFormat='{}{0} 首音乐'}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="Ghost Icon" Command="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).UnsubscribeChannelCommand}"
                                CommandParameter="{Binding}" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="0"
                                ToolTip.Tip="取消订阅" lumina:LuminaButton.IconSize="18">
                          <icons:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource MusicTextSoftBrush}" />
                        </Button>
                      </Grid>
                    </lumina:LuminaCard>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="推荐歌单" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
              <TextBlock Text="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).StatusMessage}" Foreground="{DynamicResource MusicTextSoftBrush}" />
            </StackPanel>
            <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).IsLoading}" Width="120" Height="4" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </DataTemplate>

      <DataTemplate DataType="vm:PlaylistCardRow">
        <ItemsControl ItemsSource="{Binding Playlists}" Margin="12,0,12,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="kugou:KugouPlaylist">
              <lumina:LuminaCard Width="144" Height="214" Margin="0,0,10,12" Padding="8" Classes="Interactive" CornerRadius="14" Cursor="Hand"
                                 lumina:LuminaCommand.TappedCommand="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).OpenPlaylistCommand}"
                                 lumina:LuminaCommand.TappedCommandParameter="{Binding}">
                <StackPanel Spacing="12">
                  <Border Width="128" Height="128" CornerRadius="13" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True">
                    <lumina:LuminaImage Source="{Binding Pic, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                  </Border>
                  <StackPanel Spacing="6">
                    <lumina:LuminaAutoScrollText Text="{Binding Name}" IsRunning="{Binding $parent[lumina:LuminaCard].IsPointerOver}" FontWeight="Black" FontSize="13" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                    <lumina:LuminaAutoScrollText Text="{Binding Nickname}" IsRunning="{Binding $parent[lumina:LuminaCard].IsPointerOver}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding PlayCount, StringFormat='播放 {0}'}" FontSize="12" Foreground="{DynamicResource MusicTextMutedBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                  </StackPanel>
                </StackPanel>
              </lumina:LuminaCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>

      <DataTemplate DataType="vm:PlaylistsFooterSection">
        <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="12,8,12,30">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).IsLoadingMore}" Width="120" Height="4" />
          <Button Classes="Ghost" Command="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).LoadMoreCommand}" IsVisible="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).CanLoadMore}" Height="38" CornerRadius="19" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="18,0">
            <TextBlock Text="加载更多" FontWeight="Bold" Foreground="{DynamicResource MusicTextBrush}" />
          </Button>
        </StackPanel>
      </DataTemplate>
    </ListBox.DataTemplates>
  </controls:PageInsetListBox>
</UserControl>
