<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
             xmlns:controls="using:KuGouMusicAvalonia.Controls"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:kugou="clr-namespace:KuGou.Lite;assembly=KuGouLiteSdk"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="KuGouMusicAvalonia.Views.DiscoverView"
             x:DataType="vm:DiscoverViewModel"
             x:CompileBindings="True">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,0,12,28" Spacing="18">
      <Border CornerRadius="20" MinHeight="180" ClipToBounds="True" Background="{DynamicResource MusicHeroGradient}" BoxShadow="{DynamicResource MusicFloatingShadow}">
        <Grid>

          <Grid ColumnDefinitions="*,104" ColumnSpacing="16" Margin="18" VerticalAlignment="Bottom">
            <StackPanel Spacing="8" VerticalAlignment="Bottom" MinWidth="0">
              <TextBlock Text="DISCOVER" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicPrimaryBrush}" />
              <lumina:LuminaAutoScrollText Text="{Binding HeroTitle}" IsRunning="{Binding $parent[Border].IsPointerOver}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
              <lumina:LuminaAutoScrollText Text="{Binding HeroArtist}" IsRunning="{Binding $parent[Border].IsPointerOver}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Button Classes="Primary Icon" Command="{Binding PlayFeaturedSongCommand}" IsEnabled="{Binding HasFeaturedSong}" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource MusicPrimaryGradient}" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" Padding="0" ToolTip.Tip="立即播放" lumina:LuminaButton.IconSize="22">
                  <icons:MaterialIcon Kind="Play" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" Width="22" Height="22" />
                </Button>
              </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Width="96" Height="96" CornerRadius="48" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True" BoxShadow="{DynamicResource MusicSoftShadow}" VerticalAlignment="Bottom" HorizontalAlignment="Right">
              <lumina:LuminaImage Source="{Binding HeroCoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <StackPanel>
          <TextBlock Text="新歌速递" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" />
        </StackPanel>
        <WrapPanel Grid.Row="1">
          <Button Classes="Primary Icon" Command="{Binding PlayAllCommand}" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource MusicPrimaryGradient}" Padding="0" Margin="0,0,8,8" ToolTip.Tip="播放全部" lumina:LuminaButton.IconSize="21">
            <icons:MaterialIcon Kind="Play" Width="21" Height="21" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
          </Button>
          <Button Classes="Ghost Icon" Command="{Binding QueueAllCommand}" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="0" Margin="0,0,8,8" ToolTip.Tip="加入队列" lumina:LuminaButton.IconSize="21">
            <icons:MaterialIcon Kind="PlaylistMusic" Width="21" Height="21" Foreground="{DynamicResource MusicTextBrush}" />
          </Button>
        </WrapPanel>
      </Grid>

      <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" Margin="0,12" Spacing="10">
        <ProgressBar IsIndeterminate="True" Width="160" Height="4" />
        <TextBlock Text="正在加载音乐库..." Foreground="{DynamicResource MusicTextSoftBrush}" />
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding NewSongs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="kugou:KugouSong">
              <lumina:LuminaCard Width="150" Height="208" Margin="0,0,14,6" Padding="10" Classes="Interactive" CornerRadius="14" Cursor="Hand"
                                 lumina:LuminaCommand.TappedCommand="{Binding $parent[UserControl].((vm:DiscoverViewModel)DataContext).PlaySongCommand}"
                                 lumina:LuminaCommand.TappedCommandParameter="{Binding}">
                <StackPanel Spacing="12">
                  <Border Width="130" Height="130" CornerRadius="12" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True">
                    <lumina:LuminaImage Source="{Binding CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                  </Border>
                  <StackPanel Spacing="4">
                    <lumina:LuminaAutoScrollText Text="{Binding Title}" IsRunning="{Binding $parent[lumina:LuminaCard].IsPointerOver}" FontWeight="Black" FontSize="13" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                    <lumina:LuminaAutoScrollText Text="{Binding Artist}" IsRunning="{Binding $parent[lumina:LuminaCard].IsPointerOver}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </StackPanel>
              </lumina:LuminaCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel>
          <TextBlock Text="猜你喜欢 FM" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
          <TextBlock Text="{Binding PersonalFmStatusMessage}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" />
        </StackPanel>
        <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsPersonalFmLoading}" Width="100" Height="4" VerticalAlignment="Center" />
      </Grid>

      <Border CornerRadius="18" Background="{DynamicResource MusicSurfaceBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" Padding="12" ClipToBounds="True">
        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="12">
          <Border Width="80" Height="80" CornerRadius="16" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True" HorizontalAlignment="Left">
            <lumina:LuminaImage Source="{Binding PersonalFmCoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" Stretch="UniformToFill" PlaceholderContent=" " ErrorContent=" " />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" MinWidth="0">
            <TextBlock Text="私人电台" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MusicPrimaryBrush}" />
            <lumina:LuminaAutoScrollText Text="{Binding PersonalFmTitle}" IsRunning="{Binding $parent[Border].IsPointerOver}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
            <lumina:LuminaAutoScrollText Text="{Binding PersonalFmArtist}" IsRunning="{Binding $parent[Border].IsPointerOver}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
            <lumina:LuminaAutoScrollText Text="{Binding PersonalFmAlbumText}" IsRunning="{Binding $parent[Border].IsPointerOver}" FontSize="12" Foreground="{DynamicResource MusicTextMutedBrush}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Classes="Primary Icon" Command="{Binding StartPersonalFmCommand}" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource MusicPrimaryGradient}" Padding="0" lumina:LuminaButton.IsLoading="{Binding IsPersonalFmLoading}" ToolTip.Tip="播放 FM" lumina:LuminaButton.IconSize="21">
              <icons:MaterialIcon Kind="Play" Width="21" Height="21" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
            </Button>
            <Button Classes="Ghost Icon" Command="{Binding NextPersonalFmCommand}" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="0" ToolTip.Tip="下一首" lumina:LuminaButton.IconSize="20">
              <icons:MaterialIcon Kind="SkipNext" Width="20" Height="20" Foreground="{DynamicResource MusicTextBrush}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <StackPanel>
            <TextBlock Text="Youth 推荐" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
            <TextBlock Text="{Binding YouthStatusMessage}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" />
          </StackPanel>
          <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsYouthLoading}" Width="100" Height="4" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Classes="Primary Icon" Command="{Binding PlayAllYouthCommand}" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource MusicPrimaryGradient}" Padding="0"
                    ToolTip.Tip="播放全部" lumina:LuminaButton.IconSize="21">
              <icons:MaterialIcon Kind="Play" Width="21" Height="21" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
            </Button>
            <Button Classes="Ghost Icon" Command="{Binding QueueAllYouthCommand}" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="0"
                    ToolTip.Tip="加入队列" lumina:LuminaButton.IconSize="21">
              <icons:MaterialIcon Kind="PlaylistMusic" Width="21" Height="21" Foreground="{DynamicResource MusicTextBrush}" />
            </Button>
            <Button Classes="Primary Icon" Command="{Binding LoadYouthRecommendationCommand}"
                    Width="36" Height="36" CornerRadius="18" Background="{DynamicResource MusicPrimaryGradient}" Padding="0"
                    ToolTip.Tip="刷新" lumina:LuminaButton.IconSize="21" lumina:LuminaButton.IsLoading="{Binding IsYouthLoading}">
              <icons:MaterialIcon Kind="Refresh" Width="21" Height="21" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding YouthSongs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="kugou:KugouSong">
                <lumina:LuminaCard Width="150" Height="208" Margin="0,0,14,6" Padding="10" Classes="Interactive" CornerRadius="14" Cursor="Hand"
                                   lumina:LuminaCommand.TappedCommand="{Binding $parent[UserControl].((vm:DiscoverViewModel)DataContext).PlayYouthSongCommand}"
                                   lumina:LuminaCommand.TappedCommandParameter="{Binding}">
                  <StackPanel Spacing="12">
                    <Border Width="130" Height="130" CornerRadius="12" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True">
                      <lumina:LuminaImage Source="{Binding CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                    </Border>
                    <StackPanel Spacing="4">
                      <lumina:LuminaAutoScrollText Text="{Binding Title}" IsRunning="{Binding $parent[lumina:LuminaCard].IsPointerOver}" FontWeight="Black" FontSize="13" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                      <lumina:LuminaAutoScrollText Text="{Binding Artist}" IsRunning="{Binding $parent[lumina:LuminaCard].IsPointerOver}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </StackPanel>
                </lumina:LuminaCard>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <controls:PageBottomInsetSpacer />
    </StackPanel>
  </ScrollViewer>
</UserControl>
