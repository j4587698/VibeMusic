<lumina:LuminaWindow xmlns="https://github.com/avaloniaui"
                                                                                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                                                                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                                                                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                                                                 xmlns:views="using:KuGouMusicAvalonia.Views"
                                                                                 xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
                                                                                 mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
                                                                                 x:Class="KuGouMusicAvalonia.Views.MainWindow"
                                                                                 Icon="/Assets/vibe-logo.ico"
                                                                                 Title="VibeMusic"
                                                                                 Width="1180"
                                                                                 Height="760"
                                                                                 MinWidth="360"
                                                                                 MinHeight="640"
                                                                                 WindowStartupLocation="CenterScreen"
                                                                                 WindowChromeMode="Extended"
                                                                                 ExtendedSystemButtonMode="Auto"
                                                                                 UseWindowGlass="True">
        <lumina:LuminaWindow.TitleBarLeftContent>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0">
                        <Border Width="18" Height="18" CornerRadius="5" ClipToBounds="True">
                                <Image Source="/Assets/vibe-logo.png" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="VIBE MUSIC" FontSize="11" FontWeight="Black" Foreground="{DynamicResource LuminaTextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
        </lumina:LuminaWindow.TitleBarLeftContent>

        <views:MainView />
</lumina:LuminaWindow>

