<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
             xmlns:services="using:KuGouMusicAvalonia.Services"
             xmlns:converters="using:KuGouMusicAvalonia.Converters"
             xmlns:controls="using:KuGouMusicAvalonia.Controls"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:kugou="clr-namespace:KuGou.Lite;assembly=KuGouLiteSdk"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="KuGouMusicAvalonia.Views.SearchView"
             x:DataType="vm:SearchViewModel"
             x:CompileBindings="True">
  <Grid>
  <controls:PageInsetListBox ItemsSource="{Binding PageItems}"
                             Background="Transparent"
                             BorderThickness="0"
                             BasePadding="0"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
      </Style>
    </ListBox.Styles>

    <ListBox.DataTemplates>
      <DataTemplate DataType="vm:SearchHeaderSection">
        <StackPanel Margin="12,0,12,16" Spacing="18">
          <StackPanel Spacing="10">
            <TextBlock Text="搜索" FontSize="28" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBox Classes="Pill Search MusicPillInput MusicSearchBox"
                       Text="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).Keyword}"
                       PlaceholderText="歌曲、艺人、专辑"
                       KeyDown="OnSearchKeyDown">
                <TextBox.InnerLeftContent>
                  <Grid Width="40" Height="40">
                    <icons:MaterialIcon Kind="Magnify" Width="23" Height="23" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </TextBox.InnerLeftContent>
              </TextBox>
              <Button Grid.Column="1" Classes="Primary Icon" Width="44" Height="44" CornerRadius="22" Padding="0" Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).SearchCommand}" Background="{DynamicResource MusicPrimaryGradient}" ToolTip.Tip="搜索" lumina:LuminaButton.IconSize="23">
                <icons:MaterialIcon Kind="Magnify" Width="23" Height="23" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
              </Button>
            </Grid>

            <WrapPanel>
              <Button Classes="Ghost" Content="单曲" Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).SetSearchTypeCommand}" CommandParameter="{x:Static vm:SearchType.Song}" Height="34" CornerRadius="17" Padding="14,0" FontWeight="Bold" Background="{DynamicResource MusicSurfaceHighBrush}" Margin="0,0,8,8" />
              <Button Classes="Ghost" Content="歌单" Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).SetSearchTypeCommand}" CommandParameter="{x:Static vm:SearchType.Playlist}" Height="34" CornerRadius="17" Padding="14,0" FontWeight="Bold" Background="{DynamicResource MusicSurfaceHighBrush}" Margin="0,0,8,8" />
              <Button Classes="Ghost" Content="歌手" Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).SetSearchTypeCommand}" CommandParameter="{x:Static vm:SearchType.Artist}" Height="34" CornerRadius="17" Padding="14,0" FontWeight="Bold" Background="{DynamicResource MusicSurfaceHighBrush}" Margin="0,0,8,8" />
              <Button Classes="Ghost" Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).OpenAudioMatchUICommand}" Height="34" CornerRadius="17" Padding="14,0" FontWeight="Bold" Background="{DynamicResource MusicSurfaceHighBrush}" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:MaterialIcon Kind="Microphone" Width="18" Height="18" Foreground="{DynamicResource MusicPrimaryBrush}" />
                  <TextBlock Text="听歌识曲" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock Text="热门搜索" FontSize="18" FontWeight="Black" Foreground="{DynamicResource MusicTextSoftBrush}" />
            <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).HotKeywords}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sys:String">
                  <Button Classes="Ghost" Margin="0,0,8,8" MinHeight="34" CornerRadius="17" Padding="14,0" Background="{DynamicResource MusicSurfaceHighBrush}" Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).UseKeywordCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" FontWeight="SemiBold" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).SearchHistories.Count}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="搜索历史" FontSize="18" FontWeight="Black" Foreground="{DynamicResource MusicTextSoftBrush}" VerticalAlignment="Center" />
              <lumina:LuminaPopConfirm Grid.Column="1"
                                        Classes="Danger"
                                        PopupHeader="清空搜索历史？"
                                        PopupContent="此操作会删除当前搜索历史记录，无法撤销。"
                                        ConfirmText="清空"
                                        CancelText="取消"
                                        ConfirmCommand="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).ClearHistoryCommand}">
                <lumina:LuminaPopConfirm.Icon>
                  <icons:MaterialIcon Kind="DeleteAlert" Width="20" Height="20" />
                </lumina:LuminaPopConfirm.Icon>
                <Button Classes="Ghost Icon" Width="32" Height="32" ToolTip.Tip="清空历史记录" lumina:LuminaButton.IconSize="18">
                  <lumina:LuminaButton.Icon>
                    <icons:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="{DynamicResource MusicTextSoftBrush}" />
                  </lumina:LuminaButton.Icon>
                </Button>
              </lumina:LuminaPopConfirm>
            </Grid>
            <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).SearchHistories}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sys:String">
                  <Button Classes="Ghost" Margin="0,0,8,8" MinHeight="34" CornerRadius="17" Padding="14,0" Background="{DynamicResource MusicSurfaceHighBrush}" Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).UseKeywordCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource MusicTextBrush}" FontWeight="SemiBold" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
            <StackPanel MinWidth="0">
              <TextBlock Text="搜索结果" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
              <TextBlock Text="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).StatusMessage}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" />
            </StackPanel>
            <WrapPanel Grid.Row="1">
              <Button Classes="Primary Icon" Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).PlayAllCommand}" IsVisible="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).IsSongSearch}" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource MusicPrimaryGradient}" Padding="0" Margin="0,0,8,8" ToolTip.Tip="播放全部" lumina:LuminaButton.IconSize="21">
                <icons:MaterialIcon Kind="Play" Width="21" Height="21" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
              </Button>
              <Button Classes="Ghost Icon" Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).QueueAllCommand}" IsVisible="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).IsSongSearch}" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="0" Margin="0,0,8,8" ToolTip.Tip="加入队列" lumina:LuminaButton.IconSize="21">
                <icons:MaterialIcon Kind="PlaylistMusic" Width="21" Height="21" Foreground="{DynamicResource MusicTextBrush}" />
              </Button>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).IsLoading}" Width="100" Height="4" VerticalAlignment="Center" Margin="0,0,8,8" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </DataTemplate>

      <DataTemplate DataType="kugou:KugouSong">
        <controls:MusicSongItem ItemBackground="{DynamicResource MusicGlassBrush}"
                                ItemBorderBrush="{DynamicResource LuminaBorderDefaultBrush}"
                                CoverWidth="44" CoverHeight="44"
                                PlayCommand="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).PlaySongCommand}"
                                AddToQueueCommand="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).AddSongToQueueCommand}"
                                DownloadCommand="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).DownloadSongCommand}" />
      </DataTemplate>

      <DataTemplate DataType="kugou:KugouPlaylist">
        <Button Classes="Ghost" Margin="12,0,12,8" Height="60" CornerRadius="14" Padding="10" Background="{DynamicResource MusicGlassBrush}" HorizontalContentAlignment="Left"
                Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).OpenPlaylistCommand}" CommandParameter="{Binding}">
          <Grid ColumnDefinitions="40,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True">
              <lumina:LuminaImage Source="{Binding Pic, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <lumina:LuminaAutoScrollText Text="{Binding Name}" IsRunning="{Binding $parent[Button].IsPointerOver}" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding PlayCount, StringFormat='播放 {0}'}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" />
            </StackPanel>
          </Grid>
        </Button>
      </DataTemplate>

      <DataTemplate DataType="kugou:KugouArtist">
        <Button Classes="Ghost" Margin="12,0,12,8" Height="60" CornerRadius="30" Padding="10" Background="{DynamicResource MusicGlassBrush}" HorizontalContentAlignment="Left"
                Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).OpenArtistCommand}" CommandParameter="{Binding}">
          <Grid ColumnDefinitions="40,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True">
              <lumina:LuminaImage Source="{Binding Pic, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <lumina:LuminaAutoScrollText Text="{Binding Name}" IsRunning="{Binding $parent[Button].IsPointerOver}" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding FansCount, StringFormat='粉丝 {0}'}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" />
            </StackPanel>
          </Grid>
        </Button>
      </DataTemplate>
    </ListBox.DataTemplates>
  </controls:PageInsetListBox>

  <!-- Audio Match Overlay -->
  <Grid IsVisible="{Binding IsAudioMatchUIVisible}"
        Background="#D0000000"
        ZIndex="100"
        lumina:LuminaBack.IsEnabled="{Binding IsAudioMatchUIVisible}"
        lumina:LuminaBack.Command="{Binding CloseAudioMatchUICommand}">
    <Button Classes="Ghost Icon" Command="{Binding CloseAudioMatchUICommand}" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" Background="#30FFFFFF">
      <icons:MaterialIcon Kind="Close" Width="24" Height="24" Foreground="White" />
    </Button>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="40">
      <TextBlock Text="{Binding AudioMatchStatus}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />

      <Grid Width="240" Height="240" HorizontalAlignment="Center">
        <!-- Ripple Animation when recording -->
        <Border CornerRadius="120" Background="{DynamicResource MusicPrimaryBrush}" Opacity="0.3" IsVisible="{Binding IsRecording}">
          <Border.Styles>
            <Style Selector="Border">
              <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite">
                  <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    <Setter Property="Opacity" Value="0.6"/>
                  </KeyFrame>
                  <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.6"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.6"/>
                    <Setter Property="Opacity" Value="0"/>
                  </KeyFrame>
                </Animation>
              </Style.Animations>
            </Style>
          </Border.Styles>
        </Border>

        <!-- Loading Indicator when matching -->
        <icons:MaterialIcon Kind="Loading" Width="80" Height="80" Foreground="{DynamicResource MusicPrimaryBrush}" IsVisible="{Binding IsAudioMatching}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <icons:MaterialIcon.Styles>
            <Style Selector="icons|MaterialIcon">
              <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                  <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                  </KeyFrame>
                  <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                  </KeyFrame>
                </Animation>
              </Style.Animations>
            </Style>
          </icons:MaterialIcon.Styles>
        </icons:MaterialIcon>

        <!-- Main Button (Press and Hold) -->
        <Border x:Name="AudioMatchRecordButton" Width="140" Height="140" CornerRadius="70" Background="{DynamicResource MusicPrimaryGradient}" HorizontalAlignment="Center" VerticalAlignment="Center" PointerPressed="OnRecordButtonPressed" PointerReleased="OnRecordButtonReleased" Cursor="Hand" IsVisible="{Binding !IsAudioMatching}">
          <icons:MaterialIcon Kind="Microphone" Width="56" Height="56" Foreground="White" />
        </Border>
      </Grid>

      <TextBlock Text="按住上方按钮不要松开" FontSize="16" Foreground="#A0FFFFFF" HorizontalAlignment="Center" IsVisible="{Binding !IsAudioMatching}" />
    </StackPanel>
  </Grid>
  </Grid>
</UserControl>
