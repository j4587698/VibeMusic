<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
             xmlns:services="using:KuGouMusicAvalonia.Services"
             xmlns:controls="using:KuGouMusicAvalonia.Controls"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="KuGouMusicAvalonia.Views.NowPlayingView"
             x:DataType="vm:NowPlayingViewModel"
             x:CompileBindings="True">
  <Grid Background="{DynamicResource MusicBackgroundBrush}">
    <Border Background="{DynamicResource MusicHeroGradient}" Opacity="0.26" />

    <Grid x:Name="NowPlayingRoot" Margin="20,8,20,10" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="6">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <Button Classes="Ghost Icon" Width="40" Height="40" Command="{Binding CloseCommand}" ToolTip.Tip="返回" lumina:LuminaButton.IconSize="26">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="ChevronDown" Width="26" Height="26" Foreground="{DynamicResource MusicPrimaryBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="正在播放" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicTextSoftBrush}" />
          <TextBlock Text="{Binding Player.QueueStatusText}" FontSize="13" Foreground="{DynamicResource MusicTextMutedBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
          <TextBlock IsVisible="{Binding Player.IsDownloading}" Text="{Binding Player.DownloadProgressText}" FontSize="12" Foreground="{DynamicResource MusicPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
        </StackPanel>
        <Button Grid.Column="2" Classes="Ghost Icon" Width="40" Height="40" Command="{Binding DownloadCommand}" ToolTip.Tip="下载到本地" IsEnabled="{Binding !Player.IsDownloading}" lumina:LuminaButton.IconSize="24">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Download" Width="24" Height="24" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
        <Button Grid.Column="3" Classes="Ghost Icon" Width="40" Height="40" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="{Binding Player.FavoriteStatusText}" lumina:LuminaButton.IconSize="24">
  <lumina:LuminaButton.Icon>
    <Grid>
                <icons:MaterialIcon IsVisible="{Binding !Player.IsCurrentSongFavorite}" Kind="HeartOutline" Foreground="{DynamicResource MusicTextSoftBrush}" Width="24" Height="24" />
                <icons:MaterialIcon IsVisible="{Binding Player.IsCurrentSongFavorite}" Kind="Heart" Foreground="{DynamicResource MusicPrimaryBrush}" Width="24" Height="24" />
              </Grid>
  </lumina:LuminaButton.Icon>
</Button>
      </Grid>

      <Grid Grid.Row="1" IsVisible="{Binding IsWideLayout}" ColumnDefinitions="Auto,*" ColumnSpacing="28">
        <StackPanel Width="{Binding CoverSize}" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="18" IsVisible="{Binding !IsTightLandscape}">
          <Grid Width="{Binding CoverSize}" Height="{Binding CoverSize}" HorizontalAlignment="Center">
            <Ellipse Fill="{DynamicResource MusicTextBrush}" Opacity="0.8" />
            <Ellipse Margin="22" Stroke="{DynamicResource MusicTextBrush}" StrokeThickness="10" Opacity="0.1" />
            <Ellipse Margin="78" Fill="{DynamicResource MusicCoverFallbackBrush}" />
            <Ellipse Width="48" Height="48" Fill="{DynamicResource MusicBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Classes="spinning-cover" Classes.playing="{Binding Player.IsPlaying}" Width="150" Height="150" CornerRadius="75" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Background="{DynamicResource MusicCoverFallbackBrush}" RenderTransformOrigin="50%,50%">
              <Border.RenderTransform>
                <RotateTransform />
              </Border.RenderTransform>
              <lumina:LuminaImage Source="{Binding Player.CurrentCoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" Stretch="UniformToFill" PlaceholderContent=" " ErrorContent=" " />
            </Border>
          </Grid>

          <StackPanel Spacing="7" HorizontalAlignment="Stretch">
            <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentTitle}" IdleTextAlignment="Center" FontSize="30" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
            <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentArtist}" IdleTextAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MusicPrimaryBrush}" HorizontalAlignment="Stretch" />
            <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentAlbumText}" IdleTextAlignment="Center" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </StackPanel>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" VerticalAlignment="Stretch" ClipToBounds="True">
          <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,4" IsVisible="{Binding IsTightLandscape}">
            <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentTitle}" IdleTextAlignment="Center" FontSize="20" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
            <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentArtist}" IdleTextAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicPrimaryBrush}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <Grid Grid.Row="1" ClipToBounds="True">
            <ScrollViewer x:Name="WideLyricsScrollViewer" ClipToBounds="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnLyricsScrollChanged">
              <ItemsControl x:Name="WideLyricsItemsControl" ItemsSource="{Binding Lyrics.Lines}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="services:LyricLine">
                    <Grid MinHeight="50" Margin="0,4" Opacity="{Binding DisplayOpacity}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Text}" FontSize="{Binding DisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsVisible="{Binding ShowPlain}" />
                      <controls:KaraokeTextBlock
                          Words="{Binding Words}"
                          PlaybackPosition="{Binding WordPlaybackPosition, Source={x:Static services:LyricsService.Instance}}"
                          FontSize="{Binding DisplayFontSize}"
                          FontWeight="Black"
                          TextAlignment="Center"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          SungBrush="{DynamicResource MusicPrimaryBrush}"
                          UnsungBrush="{DynamicResource MusicTextBrush}"
                          IsVisible="{Binding ShowWords}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding Lyrics.EmptyLyricsText}"
                       IsVisible="{Binding Lyrics.ShowEmptyLyrics}"
                       FontSize="24"
                       FontWeight="Black"
                       Foreground="{DynamicResource MusicTextSoftBrush}"
                       Opacity="0.72"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Lyrics.IsLoading}" Width="150" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

            <Border IsVisible="{Binding IsLyricSeekPreviewVisible}" Height="2" Margin="0,0,106,0" Background="{DynamicResource MusicPrimaryBrush}" Opacity="0.72" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Border IsVisible="{Binding IsLyricSeekPreviewVisible}" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="230" CornerRadius="18" Background="{DynamicResource LuminaPopoverBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" Padding="10" BoxShadow="{DynamicResource MusicFloatingShadow}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding LyricSeekPreviewTimeText}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource MusicPrimaryBrush}" />
                  <TextBlock Text="{Binding LyricSeekPreviewLineText}" FontSize="11" Foreground="{DynamicResource MusicTextSoftBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
                <Button Grid.Column="1" Classes="Primary Icon" Width="38" Height="38" CornerRadius="19" Command="{Binding ConfirmLyricSeekPreviewCommand}" Background="{DynamicResource MusicPrimaryGradient}" ToolTip.Tip="跳到这里播放" lumina:LuminaButton.IconSize="22">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Play" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
                <Button Grid.Column="2" Classes="Ghost Icon" Width="34" Height="34" Command="{Binding CancelLyricSeekPreviewCommand}" ToolTip.Tip="取消跳转" lumina:LuminaButton.IconSize="19">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Close" Width="19" Height="19" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <Grid Grid.Row="1" IsVisible="{Binding !IsWideLayout}">
        <Border IsVisible="{Binding IsCoverModeVisible, FallbackValue=False}" Background="Transparent" lumina:LuminaCommand.TappedCommand="{Binding ToggleCompactLyricsCommand}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="18">
            <Grid Width="{Binding CoverSize}" Height="{Binding CoverSize}" HorizontalAlignment="Center">
              <Ellipse Fill="{DynamicResource MusicTextBrush}" Opacity="0.8" />
              <Ellipse Margin="22" Stroke="{DynamicResource MusicTextBrush}" StrokeThickness="10" Opacity="0.1" />
              <Ellipse Margin="78" Fill="{DynamicResource MusicCoverFallbackBrush}" />
              <Ellipse Width="48" Height="48" Fill="{DynamicResource MusicBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border Classes="spinning-cover" Classes.playing="{Binding Player.IsPlaying}" Width="150" Height="150" CornerRadius="75" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Background="{DynamicResource MusicCoverFallbackBrush}" RenderTransformOrigin="50%,50%">
                <Border.RenderTransform>
                  <RotateTransform />
                </Border.RenderTransform>
                <lumina:LuminaImage Source="{Binding Player.CurrentCoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" Stretch="UniformToFill" PlaceholderContent=" " ErrorContent=" " />
              </Border>
            </Grid>

            <StackPanel Spacing="7" HorizontalAlignment="Stretch" IsVisible="{Binding !IsTightLandscape}">
              <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentTitle}" IdleTextAlignment="Center" FontSize="28" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
              <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentArtist}" IdleTextAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource MusicPrimaryBrush}" HorizontalAlignment="Stretch" />
              <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentAlbumText}" IdleTextAlignment="Center" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsLyricsModeVisible}" Background="Transparent" ClipToBounds="True" Tapped="OnCompactLyricsTapped">
          <Grid ClipToBounds="True">
            <Grid ClipToBounds="True">
              <ScrollViewer x:Name="CompactLyricsScrollViewer" ClipToBounds="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnLyricsScrollChanged">
                <ItemsControl x:Name="CompactLyricsItemsControl" ItemsSource="{Binding Lyrics.Lines}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="services:LyricLine">
                      <Grid MinHeight="50" Margin="0,4" Opacity="{Binding DisplayOpacity}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}" FontSize="{Binding DisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsVisible="{Binding ShowPlain}" />
                        <controls:KaraokeTextBlock
                            Words="{Binding Words}"
                            PlaybackPosition="{Binding WordPlaybackPosition, Source={x:Static services:LyricsService.Instance}}"
                            FontSize="{Binding DisplayFontSize}"
                            FontWeight="Black"
                            TextAlignment="Center"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            SungBrush="{DynamicResource MusicPrimaryBrush}"
                            UnsungBrush="{DynamicResource MusicTextBrush}"
                            IsVisible="{Binding ShowWords}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock Text="{Binding Lyrics.EmptyLyricsText}"
                         IsVisible="{Binding Lyrics.ShowEmptyLyrics}"
                         FontSize="22"
                         FontWeight="Black"
                         Foreground="{DynamicResource MusicTextSoftBrush}"
                         Opacity="0.72"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />

              <ProgressBar IsIndeterminate="True" IsVisible="{Binding Lyrics.IsLoading}" Width="140" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

              <Border IsVisible="{Binding IsLyricSeekPreviewVisible}" Height="2" Margin="0,0,106,0" Background="{DynamicResource MusicPrimaryBrush}" Opacity="0.72" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Border IsVisible="{Binding IsLyricSeekPreviewVisible}" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="220" CornerRadius="18" Background="{DynamicResource LuminaPopoverBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" Padding="10" BoxShadow="{DynamicResource MusicFloatingShadow}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LyricSeekPreviewTimeText}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource MusicPrimaryBrush}" />
                    <TextBlock Text="{Binding LyricSeekPreviewLineText}" FontSize="11" Foreground="{DynamicResource MusicTextSoftBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="Primary Icon" Width="38" Height="38" CornerRadius="19" Command="{Binding ConfirmLyricSeekPreviewCommand}" Background="{DynamicResource MusicPrimaryGradient}" ToolTip.Tip="跳到这里播放" lumina:LuminaButton.IconSize="22">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Play" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
                  <Button Grid.Column="2" Classes="Ghost Icon" Width="34" Height="34" Command="{Binding CancelLyricSeekPreviewCommand}" ToolTip.Tip="取消跳转" lumina:LuminaButton.IconSize="19">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Close" Width="19" Height="19" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="2" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch" IsVisible="{Binding !IsTightLandscape}">
        <lumina:LuminaPlaybackSlider Height="22" MinHeight="0" MaxHeight="22" VerticalAlignment="Center" Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Progress, Mode=TwoWay}" BufferedValue="{Binding Player.BufferedProgress}" TrackHeight="3" ThumbSize="10" TrackBrush="{DynamicResource LuminaDividerBrush}" BufferedBrush="{DynamicResource LuminaBorderBrush}" ProgressBrush="{DynamicResource MusicPrimaryBrush}" ThumbBrush="{DynamicResource MusicPrimaryBrush}" />
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,2,0,0">
          <TextBlock Text="{Binding Player.ProgressText}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" FontWeight="Bold" />
          <TextBlock Grid.Column="1" Text="{Binding Player.DurationText}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
        </Grid>
      </Grid>

      <Grid Grid.Row="2" IsVisible="{Binding IsTightLandscape}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center" ClipToBounds="True" ZIndex="10" Background="{DynamicResource MusicBackgroundBrush}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6" VerticalAlignment="Center">
          <Button Classes="Ghost Icon" Width="36" Height="36" Command="{Binding PreviousCommand}" ToolTip.Tip="上一首" lumina:LuminaButton.IconSize="23">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="SkipPrevious" Width="23" Height="23" Foreground="{DynamicResource MusicTextBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
          <Button Classes="Primary Icon" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource MusicPrimaryGradient}" Command="{Binding TogglePlayCommand}" ToolTip.Tip="{Binding Player.PlaybackStateText}" lumina:LuminaButton.IsLoading="{Binding Player.IsLoading}" lumina:LuminaButton.IconSize="25">
  <lumina:LuminaButton.Icon>
    <Grid>
                <icons:MaterialIcon IsVisible="{Binding !Player.IsPlaying}" Kind="Play" Width="25" Height="25" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                <icons:MaterialIcon IsVisible="{Binding Player.IsPlaying}" Kind="Pause" Width="25" Height="25" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
              </Grid>
  </lumina:LuminaButton.Icon>
</Button>
          <Button Classes="Ghost Icon" Width="36" Height="36" Command="{Binding NextCommand}" ToolTip.Tip="下一首" lumina:LuminaButton.IconSize="23">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="SkipNext" Width="23" Height="23" Foreground="{DynamicResource MusicTextBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
        </StackPanel>

        <lumina:LuminaPlaybackSlider Grid.Column="1" Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Progress, Mode=TwoWay}" BufferedValue="{Binding Player.BufferedProgress}" TrackHeight="4" ThumbSize="10" TrackBrush="{DynamicResource LuminaDividerBrush}" BufferedBrush="{DynamicResource LuminaBorderBrush}" ProgressBrush="{DynamicResource MusicPrimaryBrush}" ThumbBrush="{DynamicResource MusicPrimaryBrush}" VerticalAlignment="Center" />

        <Button Grid.Column="2" Classes="Ghost Icon" Width="34" Height="34" Command="{Binding CyclePlayModeCommand}" ToolTip.Tip="{Binding Player.PlayModeText}" lumina:LuminaButton.IconSize="21">
  <lumina:LuminaButton.Icon>
    <Grid>
                <icons:MaterialIcon IsVisible="{Binding Player.IsSequentialMode}" Kind="PlaylistPlay" Width="21" Height="21" Foreground="{DynamicResource MusicTextSoftBrush}" />
                <icons:MaterialIcon IsVisible="{Binding Player.IsListLoopMode}" Kind="Repeat" Width="21" Height="21" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <icons:MaterialIcon IsVisible="{Binding Player.IsSingleLoopMode}" Kind="RepeatOnce" Width="21" Height="21" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <icons:MaterialIcon IsVisible="{Binding Player.IsShuffleActive}" Kind="Shuffle" Width="21" Height="21" Foreground="{DynamicResource MusicPrimaryBrush}" />
              </Grid>
  </lumina:LuminaButton.Icon>
</Button>
        <Button Grid.Column="3" Classes="Ghost Icon" Width="34" Height="34" Command="{Binding ToggleQueueCommand}" ToolTip.Tip="播放队列" lumina:LuminaButton.IconSize="21">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="PlaylistMusic" Width="21" Height="21" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
      </Grid>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding !IsTightLandscape}">
        <Button Classes="Ghost Icon" Width="34" Height="34" MinWidth="0" MinHeight="0" Padding="0" Command="{Binding CyclePlayModeCommand}" ToolTip.Tip="{Binding Player.PlayModeText}" lumina:LuminaButton.IconSize="20">
  <lumina:LuminaButton.Icon>
    <Grid>
                <icons:MaterialIcon IsVisible="{Binding Player.IsSequentialMode}" Kind="PlaylistPlay" Width="20" Height="20" Foreground="{DynamicResource MusicTextSoftBrush}" />
                <icons:MaterialIcon IsVisible="{Binding Player.IsListLoopMode}" Kind="Repeat" Width="20" Height="20" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <icons:MaterialIcon IsVisible="{Binding Player.IsSingleLoopMode}" Kind="RepeatOnce" Width="20" Height="20" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <icons:MaterialIcon IsVisible="{Binding Player.IsShuffleActive}" Kind="Shuffle" Width="20" Height="20" Foreground="{DynamicResource MusicPrimaryBrush}" />
              </Grid>
  </lumina:LuminaButton.Icon>
</Button>
        <Button Classes="Ghost Icon" Width="34" Height="34" MinWidth="0" MinHeight="0" Padding="0" Command="{Binding PreviousCommand}" ToolTip.Tip="上一首" lumina:LuminaButton.IconSize="22">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="SkipPrevious" Width="22" Height="22" Foreground="{DynamicResource MusicTextBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
        <Button Classes="Primary Icon" Width="38" Height="38" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="19" Background="{DynamicResource MusicPrimaryGradient}" Command="{Binding TogglePlayCommand}" ToolTip.Tip="{Binding Player.PlaybackStateText}" lumina:LuminaButton.IsLoading="{Binding Player.IsLoading}" lumina:LuminaButton.IconSize="24">
  <lumina:LuminaButton.Icon>
    <Grid>
                <icons:MaterialIcon IsVisible="{Binding !Player.IsPlaying}" Kind="Play" Width="24" Height="24" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                <icons:MaterialIcon IsVisible="{Binding Player.IsPlaying}" Kind="Pause" Width="24" Height="24" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
              </Grid>
  </lumina:LuminaButton.Icon>
</Button>
        <Button Classes="Ghost Icon" Width="34" Height="34" MinWidth="0" MinHeight="0" Padding="0" Command="{Binding NextCommand}" ToolTip.Tip="下一首" lumina:LuminaButton.IconSize="22">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="SkipNext" Width="22" Height="22" Foreground="{DynamicResource MusicTextBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
        <Button Classes="Ghost Icon" Width="34" Height="34" MinWidth="0" MinHeight="0" Padding="0" Command="{Binding ToggleQueueCommand}" ToolTip.Tip="播放队列" lumina:LuminaButton.IconSize="21">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="PlaylistMusic" Width="21" Height="21" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
      </StackPanel>

      <Border Grid.Row="4" IsVisible="{Binding Player.HasPlaybackError}" CornerRadius="16" Background="{DynamicResource LuminaPrimaryBgBrush}" BorderBrush="{DynamicResource MusicPrimaryBrush}" BorderThickness="1" Padding="12" HorizontalAlignment="Stretch" MaxHeight="132">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <icons:MaterialIcon Kind="Alert" Width="24" Height="24" Foreground="{DynamicResource MusicPrimaryHotBrush}" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="播放错误" FontSize="14" FontWeight="Black" Foreground="{DynamicResource MusicPrimaryBrush}" />
            <TextBlock Text="{Binding Player.StatusMessage}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" TextWrapping="Wrap" MaxLines="2" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
