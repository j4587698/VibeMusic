<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
             xmlns:services="using:KuGouMusicAvalonia.Services"
             xmlns:converters="using:KuGouMusicAvalonia.Converters"
             xmlns:controls="using:KuGouMusicAvalonia.Controls"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:kugou="clr-namespace:KuGou.Lite;assembly=KuGouLiteSdk"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="KuGouMusicAvalonia.Views.RankingDetailView"
             x:DataType="vm:RankingDetailViewModel"
             x:CompileBindings="True">
  <ListBox ItemsSource="{Binding PageItems}"
           Background="Transparent"
           BorderThickness="0"
           Padding="0"
           Focusable="False"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
      </Style>
    </ListBox.Styles>

    <ListBox.DataTemplates>
      <DataTemplate DataType="vm:RankingDetailHeaderSection">
        <StackPanel Margin="12,0,12,16" Spacing="16">
          <Button Classes="Ghost" Command="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).BackCommand}" HorizontalAlignment="Left" Padding="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:MaterialIcon Kind="ArrowLeft" Width="24" Height="24" Foreground="{DynamicResource MusicPrimaryBrush}" />
              <TextBlock Text="返回排行榜" FontWeight="Bold" Foreground="{DynamicResource MusicPrimaryBrush}" />
            </StackPanel>
          </Button>

          <Border CornerRadius="22" Background="{DynamicResource MusicBlueGradient}" ClipToBounds="True" MinHeight="188" BoxShadow="{DynamicResource MusicFloatingShadow}">
            <Grid Margin="18" ColumnDefinitions="112,*" ColumnSpacing="16">
              <Border Width="104" Height="104" CornerRadius="18" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True" BoxShadow="{DynamicResource MusicSoftShadow}" VerticalAlignment="Center">
                <lumina:LuminaImage Source="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
              </Border>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="0">
                <TextBlock Text="CHART" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <lumina:LuminaAutoScrollText Text="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).Title}" FontSize="26" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                <lumina:LuminaAutoScrollText Text="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).Subtitle}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
                <WrapPanel Margin="0,4,0,0">
                  <Button Classes="Primary Icon" Command="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).PlayAllCommand}" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource MusicPrimaryGradient}" Padding="0" Margin="0,0,10,10" ToolTip.Tip="播放全部" lumina:LuminaButton.IconSize="22">
                    <icons:MaterialIcon Kind="Play" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                  </Button>
                  <Button Classes="Ghost Icon" Command="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).QueueAllCommand}" Width="38" Height="38" CornerRadius="19" Background="#33000000" Padding="0" Margin="0,0,10,10" ToolTip.Tip="加入队列" lumina:LuminaButton.IconSize="22">
                    <icons:MaterialIcon Kind="PlaylistMusic" Width="22" Height="22" Foreground="{DynamicResource MusicTextBrush}" />
                  </Button>
                </WrapPanel>
                <TextBlock Text="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).MetaText}" FontSize="12" Foreground="{DynamicResource MusicTextMutedBrush}" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="榜单歌曲" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
              <TextBlock Text="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).StatusMessage}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" />
            </StackPanel>
            <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).IsLoading}" Width="130" Height="4" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </DataTemplate>

      <DataTemplate DataType="kugou:KugouSong">
        <Border Margin="12,0,12,8" CornerRadius="14" Background="{DynamicResource MusicSurfaceBrush}" BorderBrush="{DynamicResource LuminaDividerBrush}" BorderThickness="1" Padding="10">
          <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12">
            <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True">
              <lumina:LuminaImage Source="{Binding CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:PlayingIndicator VerticalAlignment="Center">
                  <controls:PlayingIndicator.IsVisible>
                    <MultiBinding Converter="{x:Static converters:SongEqualityConverter.Instance}">
                      <Binding />
                      <Binding Path="CurrentSong" Source="{x:Static services:PlayerService.Instance}" />
                    </MultiBinding>
                  </controls:PlayingIndicator.IsVisible>
                </controls:PlayingIndicator>
                <lumina:LuminaAutoScrollText Text="{Binding Title}" FontWeight="Black" HorizontalAlignment="Stretch">
                  <lumina:LuminaAutoScrollText.Foreground>
                    <MultiBinding Converter="{x:Static converters:SongPlayingBrushConverter.Instance}">
                      <Binding />
                      <Binding Path="CurrentSong" Source="{x:Static services:PlayerService.Instance}" />
                    </MultiBinding>
                  </lumina:LuminaAutoScrollText.Foreground>
                </lumina:LuminaAutoScrollText>
              </StackPanel>
              <lumina:LuminaAutoScrollText Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="Ghost Icon" Width="36" Height="36" CornerRadius="18" ToolTip.Tip="下载到本地"
                      Command="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).DownloadSongCommand}"
                      CommandParameter="{Binding}" lumina:LuminaButton.IconSize="20">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Download" Width="20" Height="20" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
              <Button Classes="Primary Icon" Width="36" Height="36" CornerRadius="18" ToolTip.Tip="播放/暂停" Background="{DynamicResource MusicPrimaryGradient}"
                      Command="{Binding $parent[UserControl].((vm:RankingDetailViewModel)DataContext).PlaySongCommand}"
                      CommandParameter="{Binding}">
                <icons:MaterialIcon Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" Width="22" Height="22">
                  <icons:MaterialIcon.Kind>
                    <MultiBinding Converter="{x:Static converters:SongPlayIconConverter.Instance}">
                      <Binding />
                      <Binding Path="CurrentSong" Source="{x:Static services:PlayerService.Instance}" />
                      <Binding Path="IsPlaying" Source="{x:Static services:PlayerService.Instance}" />
                    </MultiBinding>
                  </icons:MaterialIcon.Kind>
                </icons:MaterialIcon>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ListBox.DataTemplates>
  </ListBox>
</UserControl>
