<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
             xmlns:services="using:KuGouMusicAvalonia.Services"
             xmlns:converters="using:KuGouMusicAvalonia.Converters"
             xmlns:controls="using:KuGouMusicAvalonia.Controls"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:kugou="clr-namespace:KuGou.Lite;assembly=KuGouLiteSdk"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="KuGouMusicAvalonia.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <controls:PageInsetListBox ItemsSource="{Binding PageItems}"
                             Background="Transparent"
                             BorderThickness="0"
                             BasePadding="0"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
      </Style>
    </ListBox.Styles>

    <ListBox.DataTemplates>
      <DataTemplate DataType="vm:HistoryHeaderSection">
        <StackPanel Margin="12,0,12,16" Spacing="16">
          <Border Padding="4,14,4,6" Background="Transparent">
            <Grid ColumnDefinitions="112,*" ColumnSpacing="16">
              <!-- Cover -->
              <Border Width="112" Height="112" CornerRadius="16" Background="{DynamicResource MusicSurfaceHighBrush}" ClipToBounds="True" BoxShadow="0 8 32 0 #33000000">
                <icons:MaterialIcon Kind="History" Width="48" Height="48" Foreground="{DynamicResource MusicTextMutedBrush}" />
              </Border>

              <!-- Info -->
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" MinWidth="0">
                <TextBlock Text="历史播放" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <TextBlock Text="最近播放记录" FontSize="28" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" TextWrapping="Wrap" MaxLines="2" />
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                  <TextBlock Text="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).SongCountText}" FontSize="14" Foreground="{DynamicResource MusicTextSoftBrush}" />
                </StackPanel>
                <WrapPanel Margin="0,4,0,0">
                  <Button Classes="Primary Icon" Width="38" Height="38" CornerRadius="19" Padding="0" Background="{DynamicResource MusicPrimaryGradient}" Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).PlayAllCommand}" ToolTip.Tip="播放全部" Margin="0,0,10,10" lumina:LuminaButton.IconSize="22">
                    <icons:MaterialIcon Kind="Play" Width="22" Height="22" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                  </Button>
                  <lumina:LuminaPopConfirm Classes="Danger"
                                           PopupHeader="清空历史播放？"
                                           PopupContent="此操作会删除当前最近播放记录，无法撤销。"
                                           ConfirmText="清空"
                                           CancelText="取消"
                                           ConfirmCommand="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).ClearHistoryCommand}"
                                           Margin="0,0,10,10">
                    <lumina:LuminaPopConfirm.Icon>
                      <icons:MaterialIcon Kind="DeleteAlert" Width="22" Height="22" />
                    </lumina:LuminaPopConfirm.Icon>
                    <Button Classes="Outline Icon" Width="38" Height="38" CornerRadius="19" Padding="0" ToolTip.Tip="清空历史" lumina:LuminaButton.IconSize="22">
                      <icons:MaterialIcon Kind="DeleteOutline" Width="22" Height="22" />
                    </Button>
                  </lumina:LuminaPopConfirm>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </DataTemplate>

      <DataTemplate DataType="kugou:KugouSong">
        <Border Margin="12,0,12,8" CornerRadius="14" Background="{DynamicResource MusicSurfaceBrush}" BorderBrush="{DynamicResource LuminaDividerBrush}" BorderThickness="1" Padding="10">
          <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12">
            <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True">
              <lumina:LuminaImage Source="{Binding CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:PlayingIndicator VerticalAlignment="Center">
                  <controls:PlayingIndicator.IsVisible>
                    <MultiBinding Converter="{x:Static converters:SongEqualityConverter.Instance}">
                      <Binding />
                      <Binding Path="CurrentSong" Source="{x:Static services:PlayerService.Instance}" />
                    </MultiBinding>
                  </controls:PlayingIndicator.IsVisible>
                </controls:PlayingIndicator>
                <lumina:LuminaAutoScrollText Text="{Binding Title}" IsRunning="{Binding $parent[Border].IsPointerOver}" FontWeight="Black" HorizontalAlignment="Stretch">
                  <lumina:LuminaAutoScrollText.Foreground>
                    <MultiBinding Converter="{x:Static converters:SongPlayingBrushConverter.Instance}">
                      <Binding />
                      <Binding Path="CurrentSong" Source="{x:Static services:PlayerService.Instance}" />
                    </MultiBinding>
                  </lumina:LuminaAutoScrollText.Foreground>
                </lumina:LuminaAutoScrollText>
              </StackPanel>
              <lumina:LuminaAutoScrollText Text="{Binding Artist}" IsRunning="{Binding $parent[Border].IsPointerOver}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <!-- Actions -->
              <Button Classes="Primary Icon" Width="36" Height="36" CornerRadius="18" ToolTip.Tip="播放/暂停" Background="{DynamicResource MusicPrimaryGradient}" Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).PlaySongCommand}" CommandParameter="{Binding}">
                  <icons:MaterialIcon Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" Width="22" Height="22">
                    <icons:MaterialIcon.Kind>
                      <MultiBinding Converter="{x:Static converters:SongPlayIconConverter.Instance}">
                        <Binding />
                        <Binding Path="CurrentSong" Source="{x:Static services:PlayerService.Instance}" />
                        <Binding Path="IsPlaying" Source="{x:Static services:PlayerService.Instance}" />
                      </MultiBinding>
                    </icons:MaterialIcon.Kind>
                  </icons:MaterialIcon>
                </Button>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ListBox.DataTemplates>
  </controls:PageInsetListBox>
</UserControl>
