<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
             xmlns:converters="using:KuGouMusicAvalonia.Converters"
             xmlns:controls="using:KuGouMusicAvalonia.Controls"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:material="clr-namespace:Material.Icons;assembly=Material.Icons"
             xmlns:kugou="clr-namespace:KuGou.Lite;assembly=KuGouLiteSdk"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="KuGouMusicAvalonia.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="True">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>
  <Grid Background="{DynamicResource MusicBackgroundBrush}">
    <lumina:LuminaShell ActiveNavigationKey="{Binding ActiveNavigationKey, Mode=TwoWay}"
                        IsMenuOpen="{Binding IsShellMenuOpen, Mode=TwoWay}"
                        IsShellChromeVisible="{Binding ShowShellChrome}"
                        IsShellHeaderVisible="{Binding ShowShellHeader}"
                        IsMenuAutoResponsive="True"
                        IsCompactMenuEnabled="True"
                        CanCompactMenu="True"
                        AutoNavigate="False"
                        CloseMenuOnNavigate="True"
                        OpenPaneLength="204"
                        CompactPaneLength="48"
                        PageContentPadding="{Binding ActiveNavigationKey, Converter={StaticResource ShellPageContentPaddingConverter}}"
                        HeaderedPageContentPadding="{Binding ActiveNavigationKey, Converter={StaticResource ShellPageContentPaddingConverter}, ConverterParameter=Headered}"
                        PaneBackground="{DynamicResource MusicBackgroundBrush}"
                        DefaultPageTitle="VIBE">

      <lumina:LuminaShell.MenuHeader>
        <StackPanel Spacing="2">
          <TextBlock Text="VIBE" FontSize="24" FontWeight="Black" Foreground="{DynamicResource MusicPrimaryBrush}" />
          <TextBlock Text="KuGou Lumina Player" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" />
        </StackPanel>
      </lumina:LuminaShell.MenuHeader>

      <lumina:LuminaShell.MenuContent>
        <lumina:LuminaNavigationView SelectedKey="{Binding ActiveNavigationKey, Mode=TwoWay}" Padding="0">
          <lumina:LuminaNavigationView.DataTemplates>
            <DataTemplate DataType="material:MaterialIconKind" x:DataType="material:MaterialIconKind">
              <icons:MaterialIcon Kind="{Binding}" Width="22" Height="22" />
            </DataTemplate>
          </lumina:LuminaNavigationView.DataTemplates>
          <lumina:LuminaNavigationView.Styles>
            <Style Selector="lumina|LuminaNavigationItem">
              <Setter Property="Height" Value="40" />
              <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style Selector="lumina|LuminaNavigationItem icons|MaterialIcon">
              <Setter Property="Width" Value="22" />
              <Setter Property="Height" Value="22" />
            </Style>
          </lumina:LuminaNavigationView.Styles>
          <lumina:LuminaNavigationItem Header="主页" NavigationKey="NavDiscover" Icon="{x:Static material:MaterialIconKind.Home}" />
          <lumina:LuminaNavigationItem Header="乐库" NavigationKey="NavPlaylists" Icon="{x:Static material:MaterialIconKind.PlaylistMusic}" />
          <lumina:LuminaNavigationItem Header="歌手" NavigationKey="NavArtists" Icon="{x:Static material:MaterialIconKind.AccountMusic}" />
          <lumina:LuminaNavigationItem Header="排行" NavigationKey="NavRankings" Icon="{x:Static material:MaterialIconKind.ChartBar}" />
          <lumina:LuminaNavigationItem Header="搜索" NavigationKey="NavSearch" Icon="{x:Static material:MaterialIconKind.Magnify}" />
          <Separator Margin="0,10" />
          <lumina:LuminaNavigationItem Header="我的" NavigationKey="NavSettings" Icon="{x:Static material:MaterialIconKind.AccountCircle}" />
        </lumina:LuminaNavigationView>
      </lumina:LuminaShell.MenuContent>

      <Grid RowDefinitions="*,Auto" Background="{DynamicResource MusicBackgroundBrush}">
          <ContentControl Grid.Row="0" Content="{Binding CurrentPage}" />

          <Grid Grid.Row="1" IsVisible="{Binding ShowMiniPlayer}">
          <Border IsVisible="{Binding IsDesktopLayout}" Background="{DynamicResource MusicGlassBrush}" BorderBrush="{DynamicResource LuminaDividerBrush}" BorderThickness="0,1,0,0" Padding="8,6,14,6">
            <Grid ColumnDefinitions="244,*,Auto" ColumnSpacing="18">
              <Border Background="Transparent" Padding="0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <Button Grid.Column="0" Classes="Ghost" Command="{Binding OpenNowPlayingCommand}" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand" ToolTip.Tip="正在播放">
                    <Grid ColumnDefinitions="52,*" ColumnSpacing="10">
                      <Border Classes="spinning-cover" Classes.playing="{Binding Player.IsPlaying}" Width="52" Height="52" CornerRadius="26" ClipToBounds="True" Background="{DynamicResource MusicCoverFallbackBrush}" RenderTransformOrigin="50%,50%" HorizontalAlignment="Left">
                        <Border.RenderTransform>
                          <RotateTransform />
                        </Border.RenderTransform>
                        <lumina:LuminaImage Source="{Binding Player.CurrentCoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" Stretch="UniformToFill" PlaceholderContent=" " ErrorContent=" " />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" MinWidth="0" HorizontalAlignment="Stretch">
                        <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentTitle}" IsRunning="{Binding $parent[Button].IsPointerOver}" FontWeight="Black" FontSize="15" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                        <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentArtist}" IsRunning="{Binding $parent[Button].IsPointerOver}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Classes="Ghost Icon" Width="34" Height="34" Command="{Binding DownloadSongCommand}" ToolTip.Tip="下载当前歌曲" IsEnabled="{Binding !Player.IsDownloading}" lumina:LuminaButton.IconSize="22">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Download" Foreground="{DynamicResource MusicTextSoftBrush}" Width="22" Height="22" />
  </lumina:LuminaButton.Icon>
</Button>
                  <Button Grid.Column="2" Classes="Ghost Icon" Width="34" Height="34" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="{Binding Player.FavoriteStatusText}" lumina:LuminaButton.IconSize="24">
  <lumina:LuminaButton.Icon>
    <Grid>
                          <icons:MaterialIcon IsVisible="{Binding !Player.IsCurrentSongFavorite}" Kind="HeartOutline" Foreground="{DynamicResource MusicTextSoftBrush}" Width="24" Height="24" />
                          <icons:MaterialIcon IsVisible="{Binding Player.IsCurrentSongFavorite}" Kind="Heart" Foreground="{DynamicResource MusicPrimaryBrush}" Width="24" Height="24" />
                        </Grid>
  </lumina:LuminaButton.Icon>
</Button>
                </Grid>
              </Border>

              <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,2">
                  <Button Classes="Ghost Icon" Width="34" Height="34" Command="{Binding CyclePlayModeCommand}" ToolTip.Tip="{Binding Player.PlayModeText}" lumina:LuminaButton.IconSize="21">
  <lumina:LuminaButton.Icon>
    <Grid>
                          <icons:MaterialIcon IsVisible="{Binding Player.IsSequentialMode}" Kind="PlaylistPlay" Width="21" Height="21" Foreground="{DynamicResource MusicTextSoftBrush}" />
                          <icons:MaterialIcon IsVisible="{Binding Player.IsListLoopMode}" Kind="Repeat" Width="21" Height="21" Foreground="{DynamicResource MusicPrimaryBrush}" />
                          <icons:MaterialIcon IsVisible="{Binding Player.IsSingleLoopMode}" Kind="RepeatOnce" Width="21" Height="21" Foreground="{DynamicResource MusicPrimaryBrush}" />
                          <icons:MaterialIcon IsVisible="{Binding Player.IsShuffleActive}" Kind="Shuffle" Width="21" Height="21" Foreground="{DynamicResource MusicPrimaryBrush}" />
                        </Grid>
  </lumina:LuminaButton.Icon>
</Button>
                  <Button Classes="Ghost Icon" Width="36" Height="36" Command="{Binding PreviousCommand}" ToolTip.Tip="上一首" lumina:LuminaButton.IconSize="23">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="SkipPrevious" Width="23" Height="23" Foreground="{DynamicResource MusicTextBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
                  <Button Classes="Primary Icon" Width="42" Height="42" CornerRadius="21" Command="{Binding TogglePlayCommand}" ToolTip.Tip="{Binding Player.PlaybackStateText}" Background="{DynamicResource MusicPrimaryGradient}" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" lumina:LuminaButton.IsLoading="{Binding Player.IsLoading}" lumina:LuminaButton.IconSize="25">
  <lumina:LuminaButton.Icon>
    <Grid>
                          <icons:MaterialIcon IsVisible="{Binding !Player.IsPlaying}" Kind="Play" Width="25" Height="25" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                          <icons:MaterialIcon IsVisible="{Binding Player.IsPlaying}" Kind="Pause" Width="25" Height="25" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                        </Grid>
  </lumina:LuminaButton.Icon>
</Button>
                  <Button Classes="Ghost Icon" Width="36" Height="36" Command="{Binding NextCommand}" ToolTip.Tip="下一首" lumina:LuminaButton.IconSize="23">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="SkipNext" Width="23" Height="23" Foreground="{DynamicResource MusicTextBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
                </StackPanel>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding Player.ProgressText}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" VerticalAlignment="Center" />
                  <lumina:LuminaPlaybackSlider Grid.Column="1" Height="22" MinHeight="0" MaxHeight="22" VerticalAlignment="Center" Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Progress, Mode=TwoWay}" BufferedValue="{Binding Player.BufferedProgress}" TrackHeight="3" ThumbSize="10" TrackBrush="#333333" BufferedBrush="#555555" ProgressBrush="{DynamicResource MusicPrimaryBrush}" ThumbBrush="{DynamicResource MusicPrimaryBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" VerticalAlignment="Center" />
                </Grid>
              </Grid>

              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <Button Classes="Ghost" Command="{Binding ToggleQueueCommand}" Height="34" MinWidth="112" MaxWidth="146" CornerRadius="17" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="10,0" ToolTip.Tip="查看播放队列">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <icons:MaterialIcon Kind="PlaylistMusic" Width="18" Height="18" Foreground="{DynamicResource MusicTextSoftBrush}" VerticalAlignment="Center" />
                    <lumina:LuminaAutoScrollText Grid.Column="1" Text="{Binding Player.QueueStatusText}" IsRunning="{Binding $parent[Button].IsPointerOver}" Foreground="{DynamicResource MusicTextSoftBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                  </Grid>
                </Button>
                <icons:MaterialIcon Kind="VolumeHigh" Width="22" Height="22" Foreground="{DynamicResource MusicSecondaryBrush}" VerticalAlignment="Center" />
                <lumina:LuminaPlaybackSlider Minimum="0" Maximum="100" Value="{Binding Player.Volume, Mode=TwoWay}" Width="76" Height="22" MinHeight="0" MaxHeight="22" TrackHeight="3" ThumbSize="10" TrackBrush="#333333" BufferedBrush="#333333" ProgressBrush="{DynamicResource MusicSecondaryBrush}" ThumbBrush="{DynamicResource MusicSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <Border IsVisible="{Binding IsCompactLayout}" Margin="12,6,12,0" CornerRadius="16" Background="{DynamicResource MusicGlassBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" ClipToBounds="True" lumina:LuminaCommand.TappedCommand="{Binding OpenNowPlayingCommand}">
            <Grid RowDefinitions="*,3">
              <Grid ColumnDefinitions="42,*,36,44" ColumnSpacing="8" Margin="8,8,10,8">
                <Border Classes="spinning-cover" Classes.playing="{Binding Player.IsPlaying}" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True" RenderTransformOrigin="50%,50%" HorizontalAlignment="Left">
                  <Border.RenderTransform>
                    <RotateTransform />
                  </Border.RenderTransform>
                  <lumina:LuminaImage Source="{Binding Player.CurrentCoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" Stretch="UniformToFill" PlaceholderContent=" " ErrorContent=" " />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <lumina:LuminaAutoScrollText Text="{Binding Player.CurrentTitle}" IsRunning="{Binding $parent[Border].IsPointerOver}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                  <lumina:LuminaAutoScrollText Text="{Binding Player.StatusMessage}" IsRunning="{Binding $parent[Border].IsPointerOver}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Player.LastErrorDetail}" />
                  <TextBlock IsVisible="{Binding Player.IsDownloading}" Text="{Binding Player.DownloadProgressText}" FontSize="11" Foreground="{DynamicResource MusicPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
                <Button Grid.Column="2" Classes="Ghost Icon" Width="36" Height="36" Command="{Binding ToggleQueueCommand}" ToolTip.Tip="播放队列">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="PlaylistMusic" Foreground="{DynamicResource MusicPrimaryBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
                <Button Grid.Column="3" Classes="Primary Icon" Width="44" Height="44" CornerRadius="22" Command="{Binding TogglePlayCommand}" Background="{DynamicResource MusicPrimaryGradient}" ToolTip.Tip="{Binding Player.PlaybackStateText}" lumina:LuminaButton.IsLoading="{Binding Player.IsLoading}" lumina:LuminaButton.IconSize="26">
  <lumina:LuminaButton.Icon>
    <Grid>
                        <icons:MaterialIcon IsVisible="{Binding !Player.IsPlaying}" Kind="Play" Width="26" Height="26" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                        <icons:MaterialIcon IsVisible="{Binding Player.IsPlaying}" Kind="Pause" Width="26" Height="26" Foreground="{DynamicResource LuminaPrimaryForegroundBrush}" />
                      </Grid>
  </lumina:LuminaButton.Icon>
</Button>
              </Grid>
              <lumina:LuminaPlaybackSlider Grid.Row="1" Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Progress, Mode=TwoWay}" BufferedValue="{Binding Player.BufferedProgress}" TrackHeight="3" ThumbSize="0" TrackBrush="#332A2A2A" BufferedBrush="#555A403E" ProgressBrush="{DynamicResource MusicPrimaryBrush}" />
            </Grid>
          </Border>
          </Grid>
      </Grid>
    </lumina:LuminaShell>

    <Grid IsVisible="{Binding IsQueueOpen}" ZIndex="20">
      <Border Background="#7A000000" lumina:LuminaCommand.TappedCommand="{Binding CloseQueueCommand}" />
      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="{Binding QueuePopupWidth}" Margin="16,16,16,90" CornerRadius="22" Background="{DynamicResource MusicGlassBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" Padding="16" BoxShadow="{DynamicResource MusicFloatingShadow}">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="播放队列" FontSize="20" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
              <lumina:LuminaAutoScrollText Text="{Binding Player.QueueStatusText}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <Button Grid.Column="1" Classes="Ghost Icon" Width="36" Height="36" Command="{Binding ClearQueueCommand}" IsVisible="{Binding Player.HasQueue}" ToolTip.Tip="清空播放队列" lumina:LuminaButton.IconSize="22">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="DeleteOutline" Width="22" Height="22" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
            <Button Grid.Column="2" Classes="Ghost Icon" Width="36" Height="36" Command="{Binding CloseQueueCommand}" ToolTip.Tip="关闭播放队列" lumina:LuminaButton.IconSize="22">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Close" Width="22" Height="22" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
          </Grid>

          <Border Grid.Row="1" IsVisible="{Binding Player.IsQueueEmpty}" CornerRadius="16" Background="{DynamicResource MusicSurfaceBrush}" Padding="18" MinHeight="110">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <icons:MaterialIcon Kind="PlaylistMusic" Width="34" Height="34" Foreground="{DynamicResource MusicTextMutedBrush}" HorizontalAlignment="Center" />
              <TextBlock IsVisible="{Binding !Player.IsRadioMode}" Text="暂无播放队列" FontWeight="Bold" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Center" />
              <TextBlock IsVisible="{Binding Player.IsRadioMode}" Text="FM 电台没有播放列表" FontWeight="Bold" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <ListBox Grid.Row="2" x:Name="QueueListBox" IsVisible="{Binding Player.HasQueue}" MaxHeight="440" ItemsSource="{Binding Player.Queue}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                  <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </ControlTemplate>
                </Setter>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="kugou:KugouSong">
                <Border Margin="0,0,16,8" CornerRadius="14" Background="{DynamicResource MusicSurfaceBrush}" BorderBrush="{DynamicResource LuminaDividerBrush}" BorderThickness="1" Padding="8">
                  <Grid ColumnDefinitions="44,*,36,36" ColumnSpacing="8">
                    <Button Grid.ColumnSpan="2" Classes="Ghost" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlayQueueSongCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="播放这一首">
                      <Grid ColumnDefinitions="42,*" ColumnSpacing="8">
                        <Border Width="42" Height="42" CornerRadius="9" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True" HorizontalAlignment="Left">
                          <lumina:LuminaImage Source="{Binding CoverUrl, Converter={StaticResource EmptyStringToNullConverter}}" Stretch="UniformToFill" PlaceholderContent=" " ErrorContent=" " />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" MinWidth="0" HorizontalAlignment="Stretch">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:PlayingIndicator VerticalAlignment="Center">
                              <controls:PlayingIndicator.IsVisible>
                                <MultiBinding Converter="{x:Static converters:SongEqualityConverter.Instance}">
                                  <Binding />
                                  <Binding Path="$parent[UserControl].((vm:MainViewModel)DataContext).Player.CurrentSong" />
                                </MultiBinding>
                              </controls:PlayingIndicator.IsVisible>
                            </controls:PlayingIndicator>
                            <lumina:LuminaAutoScrollText Text="{Binding Title}" IsRunning="{Binding $parent[Button].IsPointerOver}" FontWeight="Black" HorizontalAlignment="Stretch">
                              <lumina:LuminaAutoScrollText.Foreground>
                                <MultiBinding Converter="{x:Static converters:SongPlayingBrushConverter.Instance}">
                                  <Binding />
                                  <Binding Path="$parent[UserControl].((vm:MainViewModel)DataContext).Player.CurrentSong" />
                                </MultiBinding>
                              </lumina:LuminaAutoScrollText.Foreground>
                            </lumina:LuminaAutoScrollText>
                          </StackPanel>
                          <lumina:LuminaAutoScrollText Text="{Binding Artist}" IsRunning="{Binding $parent[Button].IsPointerOver}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                      </Grid>
                    </Button>
                    <Button Grid.Column="2" Classes="Ghost Icon" Width="36" Height="36" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlayQueueSongCommand}" CommandParameter="{Binding}" ToolTip.Tip="播放/暂停">
                      <icons:MaterialIcon Width="22" Height="22" Foreground="{DynamicResource MusicPrimaryBrush}">
                        <icons:MaterialIcon.Kind>
                          <MultiBinding Converter="{x:Static converters:SongPlayIconConverter.Instance}">
                            <Binding />
                            <Binding Path="$parent[UserControl].((vm:MainViewModel)DataContext).Player.CurrentSong" />
                            <Binding Path="$parent[UserControl].((vm:MainViewModel)DataContext).Player.IsPlaying" />
                          </MultiBinding>
                        </icons:MaterialIcon.Kind>
                      </icons:MaterialIcon>
                    </Button>
                    <Button Grid.Column="3" Classes="Ghost Icon" Width="36" Height="36" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveQueueSongCommand}" CommandParameter="{Binding}" ToolTip.Tip="从队列移除" lumina:LuminaButton.IconSize="20">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
