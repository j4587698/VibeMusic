<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
        xmlns:services="using:KuGouMusicAvalonia.Services"
        xmlns:controls="using:KuGouMusicAvalonia.Controls"
        xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="160"
        x:Class="KuGouMusicAvalonia.Views.DesktopLyricsWindow"
        x:DataType="vm:DesktopLyricsViewModel"
        x:CompileBindings="True"
        Width="800"
        Height="160"
        MinWidth="400"
        MinHeight="120"
        CanResize="True"
        Topmost="True"
        ShowInTaskbar="False"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Opened="OnWindowOpened"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">

  <Window.Styles>
    <Style Selector=":is(Control).hover-bg">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=":is(Control).hover-bg.show">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </Window.Styles>

  <Grid>
    <!-- Background overlay when hovered -->
    <Border Classes="hover-bg" Classes.show="{Binding IsHovered}" CornerRadius="16" Background="#88000000" BorderBrush="#33FFFFFF" BorderThickness="1" PointerPressed="OnDragWindow" />

    <!-- Content -->
    <Grid Margin="20,12,20,12" RowDefinitions="Auto,*,Auto">
      
      <!-- Top Bar (Visible when hovered) -->
      <Grid Classes="hover-bg" Classes.show="{Binding IsHovered}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsHitTestVisible="{Binding IsHovered}">
        <!-- Title and Artist -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center" ClipToBounds="True">
          <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource MusicPrimaryBrush}" />
          <lumina:LuminaAutoScrollText Grid.Column="1" Text="{Binding Player.CurrentTitle}" FontSize="12" FontWeight="Bold" Foreground="#E8FFFFFF" HorizontalAlignment="Stretch" MaxWidth="150" />
          <TextBlock Grid.Column="2" Text="{Binding Player.CurrentArtist}" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis" />
        </Grid>
        
        <!-- Controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="Ghost Icon" Width="28" Height="28" Padding="0" Command="{Binding ToggleLockCommand}" ToolTip.Tip="锁定歌词 (鼠标穿透，可在播放页解锁)" lumina:LuminaButton.IconSize="16">
  <lumina:LuminaButton.Icon>
    <Grid>
                  <icons:MaterialIcon IsVisible="{Binding !IsLocked}" Kind="LockOpenOutline" Width="16" Height="16" Foreground="#CCFFFFFF" />
                  <icons:MaterialIcon IsVisible="{Binding IsLocked}" Kind="Lock" Width="16" Height="16" Foreground="{DynamicResource MusicPrimaryBrush}" />
                </Grid>
  </lumina:LuminaButton.Icon>
</Button>
          <Button Classes="Ghost Icon" Width="28" Height="28" Padding="0" Click="OnCloseWindow" ToolTip.Tip="关闭桌面歌词" lumina:LuminaButton.IconSize="18">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="#CCFFFFFF" />
  </lumina:LuminaButton.Icon>
</Button>
        </StackPanel>
      </Grid>

      <!-- Lyrics (Always visible) -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6" Margin="0,4" IsHitTestVisible="False">
        <Panel HorizontalAlignment="Center">
          <TextBlock Text="{Binding Lyrics.CurrentLineText}" FontSize="36" FontWeight="Black" Foreground="{DynamicResource MusicPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" IsVisible="{Binding Lyrics.ActiveLine.ShowPlain, FallbackValue=True}" />
          <controls:KaraokeTextBlock
              Words="{Binding Lyrics.ActiveLine.Words}"
              PlaybackPosition="{Binding WordPlaybackPosition, Source={x:Static services:LyricsService.Instance}}"
              FontSize="36"
              FontWeight="Black"
              TextAlignment="Center"
              HorizontalAlignment="Center"
              SungBrush="{DynamicResource MusicPrimaryBrush}"
              UnsungBrush="#99FFFFFF"
              IsVisible="{Binding Lyrics.ActiveLine.ShowWords, FallbackValue=False}" />
        </Panel>
        <TextBlock Text="{Binding Lyrics.NextLineText}" FontSize="18" FontWeight="Bold" Foreground="#CCFFFFFF" TextAlignment="Center" TextWrapping="Wrap" MaxLines="1" />
      </StackPanel>

      <!-- Progress Bar (Visible when hovered) -->
      <Border Grid.Row="2" Classes="hover-bg" Classes.show="{Binding IsHovered}" Height="2" CornerRadius="1" Background="#24FFFFFF" IsHitTestVisible="False">
        <ProgressBar Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Progress}" Height="2" Background="Transparent" Foreground="{DynamicResource MusicPrimaryBrush}" />
      </Border>
      
    </Grid>
  </Grid>
</Window>
