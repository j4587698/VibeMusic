<lumina:LuminaFloatingWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
        xmlns:services="using:KuGouMusicAvalonia.Services"
        xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="160"
        x:Class="KuGouMusicAvalonia.Views.DesktopLyricsWindow"
        x:DataType="vm:DesktopLyricsViewModel"
        x:CompileBindings="True"
        Width="800"
        Height="{Binding WindowHeight}"
        MinWidth="400"
        MinHeight="{Binding WindowMinHeight}"
        CanResize="True"
        Topmost="True"
        ShowInTaskbar="False"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Opened="OnWindowOpened"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">

  <Window.Styles>
    <Style Selector=":is(Control).hover-bg">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector=":is(Control).hover-bg.show">
      <Setter Property="Opacity" Value="1"/>
    </Style>
  </Window.Styles>

  <Grid>
    <!-- Background overlay when hovered -->
    <Border Classes="hover-bg" Classes.show="{Binding IsHovered}" CornerRadius="16" Background="{DynamicResource MusicFloatingGlassBrush}" BorderBrush="{DynamicResource MusicOutlineBrush}" BorderThickness="1" PointerPressed="OnDragWindow" />

    <!-- Content -->
    <Grid Margin="{Binding ContentMargin}" RowDefinitions="Auto,*,Auto">
      
      <!-- Top Bar (Visible when hovered) -->
      <Grid Classes="hover-bg" Classes.show="{Binding IsHovered}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsHitTestVisible="{Binding IsHovered}" IsVisible="{Binding ShowExpandedContent}">
        <!-- Title and Artist -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center" ClipToBounds="True">
          <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource MusicPrimaryBrush}" />
          <lumina:LuminaAutoScrollText Grid.Column="1" Text="{Binding Player.CurrentTitle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" MaxWidth="150" />
          <TextBlock Grid.Column="2" Text="{Binding Player.CurrentArtist}" FontSize="11" Foreground="{DynamicResource MusicTextMutedBrush}" VerticalAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis" />
        </Grid>
        
        <!-- Controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="Ghost Icon" Width="28" Height="28" Padding="0" Command="{Binding ToggleLockCommand}" ToolTip.Tip="锁定悬浮歌词 (鼠标穿透，可在设置页解锁)" lumina:LuminaButton.IconSize="16">
  <lumina:LuminaButton.Icon>
    <Grid>
                  <icons:MaterialIcon IsVisible="{Binding !IsLocked}" Kind="LockOpenOutline" Width="16" Height="16" Foreground="{DynamicResource MusicTextSoftBrush}" />
                  <icons:MaterialIcon IsVisible="{Binding IsLocked}" Kind="Lock" Width="16" Height="16" Foreground="{DynamicResource MusicPrimaryBrush}" />
                </Grid>
  </lumina:LuminaButton.Icon>
</Button>
          <Button Classes="Ghost Icon" Width="28" Height="28" Padding="0" Click="OnCloseWindow" ToolTip.Tip="关闭悬浮歌词" lumina:LuminaButton.IconSize="18">
  <lumina:LuminaButton.Icon>
    <icons:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="{DynamicResource MusicTextSoftBrush}" />
  </lumina:LuminaButton.Icon>
</Button>
        </StackPanel>
      </Grid>

      <!-- Lyrics (Always visible) -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6" Margin="0,4" IsHitTestVisible="False">
        <Grid HorizontalAlignment="Stretch">
          <lumina:LuminaOutlinedTextBlock Text="{Binding Lyrics.CurrentLineText}" FontSize="{Binding CurrentLineFontSize}" FontWeight="Black" Foreground="{DynamicResource MusicPrimaryBrush}" Stroke="#66000000" StrokeThickness="1.5" TextAlignment="Center" TextWrapping="Wrap" MaxLines="{Binding CurrentLineMaxLines}" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsVisible="{Binding Lyrics.ActiveLine.ShowPlain, FallbackValue=True}" />
          <lumina:LuminaKaraokeTextBlock
              Words="{Binding Lyrics.ActiveLine.Words}"
              PlaybackPosition="{Binding WordPlaybackPosition, Source={x:Static services:LyricsService.Instance}}"
              FontSize="{Binding CurrentLineFontSize}"
              FontWeight="Black"
              TextAlignment="Center"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              SungBrush="{DynamicResource MusicPrimaryBrush}"
              UnsungBrush="{DynamicResource MusicTextMutedBrush}"
              StrokeBrush="#66000000"
              StrokeThickness="1.5"
              IsVisible="{Binding Lyrics.ActiveLine.ShowWords, FallbackValue=False}" />
        </Grid>
        <lumina:LuminaOutlinedTextBlock Text="{Binding Lyrics.NextLineText}" FontSize="{Binding NextLineFontSize}" FontWeight="Bold" Foreground="{DynamicResource MusicTextMutedBrush}" Stroke="#66000000" StrokeThickness="1" TextAlignment="Center" TextWrapping="Wrap" MaxLines="1" HorizontalAlignment="Stretch" IsVisible="{Binding ShowExpandedContent}" />
      </StackPanel>

      <!-- Progress Bar (Visible when hovered) -->
      <Border Grid.Row="2" Classes="hover-bg" Classes.show="{Binding IsHovered}" Height="2" CornerRadius="1" Background="{DynamicResource LuminaDividerBrush}" IsHitTestVisible="False" IsVisible="{Binding ShowExpandedContent}">
        <ProgressBar Minimum="0" Maximum="{Binding Player.Duration}" Value="{Binding Player.Progress}" Height="2" Background="Transparent" Foreground="{DynamicResource MusicPrimaryBrush}" />
      </Border>
      
    </Grid>
  </Grid>
</lumina:LuminaFloatingWindow>
