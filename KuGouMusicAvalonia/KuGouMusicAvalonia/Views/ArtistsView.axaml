<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KuGouMusicAvalonia.ViewModels"
             xmlns:controls="using:KuGouMusicAvalonia.Controls"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:kugou="clr-namespace:KuGou.Lite;assembly=KuGouLiteSdk"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="KuGouMusicAvalonia.Views.ArtistsView"
             x:DataType="vm:ArtistsViewModel"
             x:CompileBindings="True">
  <controls:PageInsetListBox x:Name="ArtistsPageList"
                             ItemsSource="{Binding PageItems}"
                             Background="Transparent"
                             BorderThickness="0"
                             BasePadding="0"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>

    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
      </Style>
    </ListBox.Styles>

    <ListBox.DataTemplates>
      <DataTemplate DataType="vm:ArtistsHeaderSection">
        <StackPanel Margin="12,0,12,8" Spacing="18">
          <Border CornerRadius="22" MinHeight="176" Background="{DynamicResource MusicHeroGradient}" ClipToBounds="True" BoxShadow="{DynamicResource MusicFloatingShadow}">
            <Grid Margin="18" ColumnDefinitions="*,112" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center" Spacing="8" MinWidth="0">
                <TextBlock Text="ARTISTS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicPrimaryBrush}" />
                <TextBlock Text="歌手" FontSize="28" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" TextWrapping="Wrap" MaxLines="2" />
                <TextBlock Text="按地区、性别和音乐人分类浏览，点开歌手后进入独立详情页。" FontSize="14" Foreground="{DynamicResource MusicTextSoftBrush}" TextWrapping="Wrap" MaxLines="2" />
                <WrapPanel Margin="0,8,0,0">
                  <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="当前分类" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicTextSoftBrush}" />
                    <TextBlock Text="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).SelectedCategoryName}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="已加载" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MusicTextSoftBrush}" />
                    <TextBlock Text="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).VisibleArtistCountText}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
              <Border Grid.Column="1" Width="104" Height="104" CornerRadius="52" Background="#33000000" ClipToBounds="True" HorizontalAlignment="Right" VerticalAlignment="Center">
                <icons:MaterialIcon Kind="AccountMusic" Width="62" Height="62" Foreground="{DynamicResource MusicTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>

          <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
            <StackPanel MinWidth="0">
              <TextBlock Text="歌手分类" FontSize="22" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
              <TextBlock Text="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).StatusMessage}" FontSize="13" Foreground="{DynamicResource MusicTextSoftBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).IsLoading}" Width="110" Height="4" VerticalAlignment="Center" />
              <Button Classes="Ghost Icon" Command="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).LoadArtistsCommand}" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="0" ToolTip.Tip="刷新" lumina:LuminaButton.IconSize="21">
                <icons:MaterialIcon Kind="Refresh" Width="21" Height="21" Foreground="{DynamicResource MusicTextBrush}" />
              </Button>
            </StackPanel>
          </Grid>

          <ListBox ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" ItemsSource="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).ArtistCategories}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                  <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </ControlTemplate>
                </Setter>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ArtistCategoryOption">
                <Button Classes="Ghost" Margin="0,0,10,4" Height="42" CornerRadius="21" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="14,0"
                        Command="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).SelectArtistCategoryCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:MaterialIcon Kind="AccountMusic" Width="20" Height="20" Foreground="{DynamicResource MusicPrimaryBrush}" />
                    <TextBlock Text="{Binding Name}" FontWeight="Black" Foreground="{DynamicResource MusicTextBrush}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DataTemplate>

      <DataTemplate DataType="vm:ArtistCardRow">
        <ItemsControl ItemsSource="{Binding Artists}" Margin="12,0,12,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="kugou:KugouArtist">
              <lumina:LuminaCard Width="144" Height="202" Margin="0,0,10,12" Padding="9" Classes="Glass Interactive" CornerRadius="14" Cursor="Hand"
                                 lumina:LuminaCommand.TappedCommand="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).OpenArtistCommand}"
                                 lumina:LuminaCommand.TappedCommandParameter="{Binding}">
                <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                  <Border Width="104" Height="104" CornerRadius="52" Background="{DynamicResource MusicCoverFallbackBrush}" ClipToBounds="True" HorizontalAlignment="Center">
                    <lumina:LuminaImage Source="{Binding Pic, Converter={StaticResource EmptyStringToNullConverter}}" PlaceholderContent=" " ErrorContent=" " />
                  </Border>
                  <StackPanel Spacing="5">
                    <lumina:LuminaAutoScrollText Text="{Binding Name}" IdleTextAlignment="Center" IsRunning="{Binding $parent[lumina:LuminaCard].IsPointerOver}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource MusicTextBrush}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding Heat, StringFormat='热度 {0}'}" FontSize="12" Foreground="{DynamicResource MusicTextSoftBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding FansCount, StringFormat='粉丝 {0}'}" FontSize="11" Foreground="{DynamicResource MusicTextMutedBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </lumina:LuminaCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>

      <DataTemplate DataType="vm:ArtistsFooterSection">
        <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="12,8,12,30">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).IsLoadingMore}" Width="120" Height="4" />
          <Button Classes="Ghost" Command="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).LoadMoreCommand}" IsVisible="{Binding $parent[UserControl].((vm:ArtistsViewModel)DataContext).CanLoadMore}" Height="38" CornerRadius="19" Background="{DynamicResource MusicSurfaceHighBrush}" Padding="18,0">
            <TextBlock Text="加载更多" FontWeight="Bold" Foreground="{DynamicResource MusicTextBrush}" />
          </Button>
        </StackPanel>
      </DataTemplate>
    </ListBox.DataTemplates>
  </controls:PageInsetListBox>
</UserControl>
