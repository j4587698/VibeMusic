<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KuGouMusicAvalonia.Controls.PlayingIndicator"
             Width="16" Height="16">
  <UserControl.Styles>
    <Style Selector="Border.bar">
      <Setter Property="Background" Value="{DynamicResource MusicPrimaryBrush}"/>
      <Setter Property="Width" Value="3"/>
      <Setter Property="CornerRadius" Value="1.5"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="Border.bar1">
      <Style.Animations>
        <Animation Duration="0:0:0.5" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Height" Value="4"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Height" Value="14"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.bar2">
      <Style.Animations>
        <Animation Duration="0:0:0.4" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Height" Value="12"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Height" Value="6"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.bar3">
      <Style.Animations>
        <Animation Duration="0:0:0.6" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Height" Value="7"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Height" Value="16"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2" VerticalAlignment="Bottom">
    <Border Classes="bar bar1" Grid.Column="0"/>
    <Border Classes="bar bar2" Grid.Column="1"/>
    <Border Classes="bar bar3" Grid.Column="2"/>
  </Grid>
</UserControl>
