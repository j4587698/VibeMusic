<Project>
  <PropertyGroup>
    <!-- Manually maintain unified app version here for all platforms. -->
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <InformationalVersion>1.1.2</InformationalVersion>

    <!-- Android version code must be an integer and should increase monotonically. -->
    <AppVersionCode>6</AppVersionCode>
  </PropertyGroup>
</Project>
